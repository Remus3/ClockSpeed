#!/bin/sh
# Clockspeed commit-msg hook - message hygiene (CONVENTIONS.md section 8).
#
# Rejects a message that is empty or whitespace only, carries any byte above
# 0x7E, carries a control byte other than tab and newline (CS-822; CR included),
# has a subject line longer than 72 characters, or is a bare placeholder used
# as the entire subject. Both byte checks run before anything echoes message
# text, and a control byte is reported by line, column and hex value only.
#
# Every check grades the message AS GIT WILL STORE IT, under every cleanup mode
# this hook cannot rule out (CS-813) - see the note above the leader read.
#
# LF line endings, no BOM - see the note in .githooks/pre-commit.
#
# The message file is read as BYTES. The checks live in one inline python
# program rather than in sh because sh cannot inspect bytes portably, and
# because the interpreter has to be resolved here anyway (no hardcoded path).

set -u

die() {
    printf 'clockspeed commit-msg: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '  %s\n' "$line" >&2
    done
    exit 1
}

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    die "no commit message file was passed to the hook."
fi

CS_PY=""
CS_PY_ARG=""
# CS-815: whether cs_probe runs its stdin half. ASSIGNED here, outside the
# byte-identical probe, never read from the environment -
# only commit-msg hands its checker on stdin, so only it runs the half.
CS_HOOK_STDIN_HALF=run

# THE PROBE PROVES THE CANDIDATE BOTH RUNS A PROGRAM AND CAN REPORT ITS FAILURE.
#
# CS-703: the previous probe ran the candidate with -c and read only its exit
# status, so `true`, `:` and `echo` all passed it. The heredoc or the gate
# invocation was then handed to that program, which ignored it and exited 0, and
# the hook reported success - one environment variable silently disarmed the
# character-set gate, the secret scan, the message checks and the pre-push suite
# at once. An unrunnable check is not a passed check, and neither is a check
# handed to something that cannot run it.
#
# THE SECOND HALF EXISTS BECAUSE THE GATES READ A CHANNEL THE FIRST HALF NEVER
# VALIDATES. Every gate decision in every one of these hooks is taken from `$?`.
# A probe that compares only stdout therefore proves the candidate RAN the
# program and says nothing about whether it can REPORT a failure - so a wrapper
# that forwards stdout faithfully and drops the exit status answers the first
# half with the exact token and turns all three tier-0 gates into no-ops. Two
# ordinary shapes do exactly that, and neither is purpose-built nor knows the
# token: a POSIX wrapper ending in `| cat`, because a pipeline's status is its
# LAST command's, and a Windows .cmd shim wrapping its body in `setlocal` /
# `endlocal`, because `endlocal` resets ERRORLEVEL. The second half hands the
# candidate a program that exits 97 and demands 97 back. The sentinel avoids 0,
# 1, 2 and 5, which are ordinary results, and 125, 126 and 127, which `env` and
# the shell itself produce on an exec failure - so a candidate that never ran the
# program cannot answer correctly by accident.
#
# CS-815: BOTH QUESTIONS ARE ASKED OF ONE START. The program prints the token
# AND exits 97, and the probe demands both from that one run. Two starts
# asked nothing more than one: a candidate that forwards stdout and drops the
# status still answers 0, and one that cannot run the program still prints
# no token. Folding them halved the probe's cost on every hook call.
#
# THAT ESCAPE WAS REACHABLE THROUGH THE `python` RUNG WITH NO ENVIRONMENT
# VARIABLE SET AT ALL. It was never a CLOCKSPEED_PYTHON problem, and unsetting
# that variable was never a mitigation for it.
#
# THE TOKEN IS ASSEMBLED FROM THREE PIECES at run time, so the string being
# compared never appears literally in the program text the candidate is handed.
# A candidate that merely echoes its arguments back cannot reproduce it by
# accident, and `echo` is the live example of one that tries.
#
# THE COMPARISON IS EXACT RATHER THAN CONTAINMENT, deliberately. Exact equality
# refuses a candidate whose stdout carries anything extra - a sitecustomize that
# prints, a .cmd shim without `@echo off`, PYTHONIOENCODING=utf-8-sig - and each
# of those is a FALSE REFUSAL this accepts knowingly. Containment would accept
# all three, and would also accept any program that emits the token among other
# output. In a gate a LOUD FALSE REFUSAL beats a SILENT FALSE ACCEPT: the
# message below fixes the first in a minute, and the second is the defect that
# made this item exist.
#
# THE TOKEN CARRIES NO TRAILING NEWLINE, so the comparison never depends on how
# the interpreter and the shell each treat a line terminator. Measured here:
# python writes CR LF to a pipe and this bash strips both, so the newline form
# happens to compare equal on THIS toolchain - exactly the version-specific
# tolerance CONVENTIONS.md section 16 says to re-measure rather than inherit.
# Writing no newline removes the dependency instead of resting on it.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY. It catches a
# MISCONFIGURED interpreter, which is what CS-703 was. It stops nobody who means
# to get past it: a program written on purpose to print the token and exit 97
# passes both halves, and `git commit --no-verify` skips every hook here without
# needing to. Never cite this probe as evidence that a commit was checked.
CS_PROBE_PROGRAM='import sys; sys.stdout.write("clockspeed-" + "python-" + "ok"); sys.exit(97)'
CS_PROBE_EXPECTED='clockspeed-python-ok'
CS_PROBE_EXIT_EXPECTED=97
CS_PROBE_BOUND=10
CS_PROBE_CAPTURE='cs_o=$("$@"); cs_r=$?; printf "%s" "$cs_o"; exit "$cs_r"'

cs_probe() {
    # ALL initialised BEFORE first use. The failure paths below render them,
    # and `set -u` would abort the hook on an unset one instead. The exit code
    # starts as a WORD rather than a number on purpose: a refusal that never
    # reached the second half must not be readable as "the candidate returned 0".
    cs_probe_out=""
    cs_probe_code="not reached"
    cs_probe_rc="not reached"
    cs_probe_bound_ok=""
    # CS-816: EVERY HALF OF THIS PROBE RUNS UNDER A BOUND OF CS_PROBE_BOUND
    # SECONDS, AND A HALF THAT DOES NOT RETURN INSIDE IT REFUSES THE HOOK.
    # Three hang shapes were measured, none of them exotic. PYTHONINSPECT=1
    # goes interactive after the program, because under MSYS /dev/null is the
    # NUL character device and reports a tty. A candidate that leaves a
    # background process holding stdout makes a command substitution wait for
    # that process rather than for the candidate. A wrapper that execs python
    # with stdin from /dev/null answers every -c program and then spins on a
    # program handed to it on stdin. The answer is a BOUND rather than an
    # enumeration of causes, and so the probe also hands the candidate one
    # program on stdin - the shape commit-msg delivers its checker in - and
    # grades only that it RETURNS.
    #
    # THE BOUND IS ONE LITERAL, byte-identical in the three hooks and never read
    # from the environment or a config file. Its value is justified against a
    # cold-start measurement in the closing record of CS-816 in docs/LEDGER.md.
    #
    # A TIMED-OUT PROBE NEVER FALLS THROUGH to the next rung. The last rung is
    # 'py -3', the measured interpreter that carries no toolchain, and a probe
    # that timed out and then proceeded is the CS-703 no-op wearing a clock. An
    # ordinary MISMATCH still falls through exactly as it always did.
    #
    # THE BOUNDING BINARY IS CHECKED BY BEHAVIOUR, NEVER BY NAME. On Windows,
    # System32 carries a 'timeout' that is a pause command with unrelated
    # semantics, behind GNU timeout on PATH. Before any candidate runs, the
    # binary must pass an ordinary exit status straight through AND return 124
    # when a short bound expires. Absent, foreign, or never expiring, it refuses
    # the hook: a probe is never run without a time limit.
    #
    # CS-1200: 137 IS A WORKING BOUND TOO. It is the KILL sent after the
    # one-second grace, and a loaded box measured it in 2 of 12 runs, when
    # 'sleep' outlived the TERM. Either status proves the bound fired; a binary
    # that never expires still answers 0 here and still refuses.
    timeout -k 1 "$CS_PROBE_BOUND" sh -c 'exit 42' </dev/null >/dev/null 2>&1
    if [ "$?" = 42 ]; then
        timeout -k 1 0.05 sleep 5 </dev/null >/dev/null 2>&1
        case "$?" in
            124 | 137) cs_probe_bound_ok="yes" ;;
        esac
    fi
    if [ "$cs_probe_bound_ok" != "yes" ]; then
        die "no working GNU timeout was found, so the interpreter probe cannot be bounded." \
            "The hook refuses rather than run a probe with no time limit (CS-816)." \
            "'timeout' is checked by behaviour: it must pass an ordinary exit status" \
            "through and return 124 when its bound expires, or 137 when the kill" \
            "after its grace ends the run. A different program of the same name," \
            "such as the Windows pause command, fails that check." \
            "Fix: put GNU coreutils 'timeout' and 'sleep' first on PATH. Git for" \
            "Windows ships both in its own usr/bin directory." \
            "BLOCKED: an unbounded probe is not a passed probe."
    fi
    # THE CAPTURE RUNS INSIDE THE BOUNDED PROCESS. CS_PROBE_CAPTURE is a small sh
    # program that takes the candidate's output itself and re-emits it, so the
    # only processes holding THIS substitution's pipe are ones the bound kills.
    # Capturing the candidate here directly would let a background process it
    # left behind hold the pipe after the bounded child exited, and this
    # substitution would wait on that process with no limit at all.
    #
    # THE EXIT STATUS IS GRADED BEFORE THE TOKEN. MEASURED under a 3 second
    # bound: PYTHONINSPECT=1 returned 124 while the capture already held the
    # exact token. 124 is the bound expiring, 137 the KILL sent when a candidate
    # ignored TERM, and 143 a TERM from elsewhere. Each refuses, whatever the
    # capture holds.
    #
    # ONE START ANSWERS BOTH QUESTIONS (CS-815). $? is captured IMMEDIATELY on
    # the next line, because any command in between - a `[` included -
    # overwrites it. The status is RECORDED only when the token matched, so
    # 'not reached' still means the output check failed or nothing ran.
    cs_probe_out=$(timeout -k 1 "$CS_PROBE_BOUND" sh -c "$CS_PROBE_CAPTURE" \
        cs_probe "$@" -c "$CS_PROBE_PROGRAM" 2>/dev/null </dev/null)
    cs_probe_rc=$?
    if [ "$cs_probe_out" = "$CS_PROBE_EXPECTED" ]; then
        cs_probe_code=$cs_probe_rc
        # THE STDIN HALF runs unless the CALLER declared CS_HOOK_STDIN_HALF as
        # 'skip' outside this probe. Every caller assigns it, so no inherited
        # value reaches here; unset - an extracted copy - runs it. Only
        # commit-msg hands a program on stdin, and only it declares 'run'.
        if [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ] &&
            [ "${CS_HOOK_STDIN_HALF:-run}" != skip ]; then
            # THE STDIN HALF grades only that the candidate RETURNS inside the
            # bound. Its output and its status are deliberately not compared:
            # this half exists for the hang, and a stricter grade here would
            # refuse candidates that the two halves above already judge.
            printf '%s' "$CS_PROBE_PROGRAM" | timeout -k 1 "$CS_PROBE_BOUND" \
                sh -c "$CS_PROBE_CAPTURE" cs_probe "$@" - >/dev/null 2>&1
            cs_probe_rc=$?
        fi
    fi
    case "$cs_probe_rc" in
        124|137|143)
            die "the interpreter probe did not answer within $CS_PROBE_BOUND seconds." \
                "Observed status: [$cs_probe_rc] (124 is the bound expiring)." \
                "A probe that times out REFUSES and never falls through to the next" \
                "rung: the last rung, 'py -3', is the measured interpreter that" \
                "carries no toolchain (CS-816)." \
                "Known causes: PYTHONINSPECT set in the environment; an interpreter" \
                "wrapper that redirects stdin from /dev/null; a wrapper that leaves a" \
                "background process holding stdout." \
                "Unset PYTHONINSPECT, or point CLOCKSPEED_PYTHON at a plain python." \
                "BLOCKED: an unanswered probe is not a passed probe."
            ;;
    esac
    # Compared as STRINGS. Both sides are literal digits here, and `=` cannot
    # raise on a non-numeric value the way `-eq` would.
    [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ]
}

# One dispatcher, so the python program below exists exactly once.
cs_python() {
    if [ -n "$CS_PY_ARG" ]; then
        "$CS_PY" "$CS_PY_ARG" "$@"
    else
        "$CS_PY" "$@"
    fi
}

# >>> CS-818 LADDER BEGIN - resolves CS_PY and CS_PY_ARG; pinned across the hooks.
if [ -n "${CLOCKSPEED_PYTHON:-}" ]; then
    # SET BUT FAILING IS A HARD FAILURE, NOT A FALL-THROUGH. The old form was
    # one `&&` condition, so a value that failed the probe fell quietly through
    # to `python`: the operator's explicit choice was overruled, the run
    # continued under an interpreter they did not pick, and nothing said so.
    # That is the CS-806 shape in a quieter form. Refusing costs one loud
    # message; falling through costs silence.
    if cs_probe "$CLOCKSPEED_PYTHON"; then
        CS_PY="$CLOCKSPEED_PYTHON"
    else
        # NONE OF THE CANDIDATE'S OUTPUT IS RENDERED, only its size (CS-814). A
        # candidate that ignores its arguments can print anything - its own
        # environment, and the live credentials in it, included - and this text
        # reaches logs and reports (CLAUDE.md non-negotiable 13). The VALUE of
        # CLOCKSPEED_PYTHON is not echoed back either: it is routinely an
        # absolute path under a home directory (non-negotiable 3).
        cs_probe_bytes=$(printf '%s' "$cs_probe_out" | wc -c 2>/dev/null | tr -d ' ')
        die "CLOCKSPEED_PYTHON is set but did not answer the probe." \
            "It must name ONE EXECUTABLE, not a command line with arguments." \
            "'py -3' is two tokens, so it cannot be this variable's value. Unset" \
            "the variable and the ladder reaches 'py -3' by itself, last." \
            "Observed probe output: [$cs_probe_bytes] bytes, not shown - a candidate" \
            "that ignores its arguments can print the environment (CS-814)." \
            "Observed exit status when asked to fail: [$cs_probe_code]" \
            "(expected $CS_PROBE_EXIT_EXPECTED; 'not reached' means this half" \
            "never ran. That happens BOTH when the candidate could not be" \
            "executed at all AND when it ran but answered the output check" \
            "wrongly - zero bytes above point at the first.)" \
            "An interpreter must BOTH run the program it is handed AND report a" \
            "failure back. That is CS-703: judging the exit code alone let 'true'," \
            "':' and 'echo' through, and judging stdout alone let a wrapper that" \
            "forwards output but drops the exit status turn every tier-0 gate" \
            "into a no-op." \
            "Point CLOCKSPEED_PYTHON at a working python executable, or unset it." \
            "The commit is BLOCKED: an unrunnable check is not a passed check."
    fi
elif cs_probe python; then
    CS_PY="python"
elif cs_probe python3; then
    CS_PY="python3"
elif cs_probe py -3; then
    CS_PY="py"
    CS_PY_ARG="-3"
else
    die "no usable python interpreter found." \
        "Tried \$CLOCKSPEED_PYTHON, 'python', 'python3', 'py -3'." \
        "Set CLOCKSPEED_PYTHON to an interpreter and retry." \
        "The commit is BLOCKED: an unrunnable check is not a passed check."
fi
# <<< CS-818 LADDER END

# CS-813: THE CHECKS GRADE THE STORED MESSAGE, NOT THE FILE THIS HOOK IS HANDED.
#
# git cleans the message AFTER this hook runs, so the file is a prediction of
# the stored bytes and never the bytes themselves. The old program predicted ONE
# cleanup mode: it dropped every '#' line and cut at any '#' line carrying '>8'
# whatever git was about to do, and four leaks followed (docs/item_notes/
# phase7.md, CS-813). Which mode git will use is only partly observable here: an
# explicit --cleanup reaches no hook, and neither does -v, which cuts at the
# scissors line whatever the mode. So the program builds the stored image under
# EVERY mode it cannot rule out - verbatim, whitespace, and strip under each
# leader, each whole and each cut at the scissors line - and refuses if ANY
# image violates. 'scissors' and 'default' add no image: each is one of those.
#
# MEASURED on git 2.53: on the -m and -F paths git runs its whitespace pass
# BEFORE this hook unless the mode is verbatim, and on the editor path it runs
# nothing. Either way the handed file IS the verbatim image, and every other
# image is a trim or a cut of it - which is why the byte check reads it whole.
#
# THE PATH IS NOT READ. GIT_EDITOR is ':' exactly when no editor ran, but the
# path could only rule images out, never add one, so grading the union of both
# paths fails closed and leaves no branch that can fail open.
#
# THE COMMENT LEADER IS READ HERE, so the program itself still spawns nothing.
# core.commentChar and core.commentString are one setting to git and the last
# one set wins, which is the order --get-regexp prints them in. 'auto' lets git
# pick per message, so the program models every leader it can pick. '#' is
# always modelled too: it is git's default, and what a git too old to know
# core.commentString still uses. Status 1 means neither key is set; any other
# failure refuses, because an unknown leader cannot be modelled. Bounded like
# the probe, and its stdout is captured rather than inherited.
cs_msg_leaders=$(timeout -k 1 "$CS_PROBE_BOUND" git config --get-regexp \
    '^core\.comment(char|string)$' 2>/dev/null </dev/null)
cs_msg_leaders_rc=$?
if [ "$cs_msg_leaders_rc" != 0 ] && [ "$cs_msg_leaders_rc" != 1 ]; then
    die "could not read the comment leader from git config (status $cs_msg_leaders_rc)." \
        "git's cleanup depends on it, so the stored message cannot be predicted." \
        "The commit is BLOCKED: an unrun check is not a passed check."
fi
CLOCKSPEED_COMMIT_MSG_LEADERS=$cs_msg_leaders
export CLOCKSPEED_COMMIT_MSG_LEADERS

# THE PROGRAM MUST PROVE IT RAN. CS-819.
#
# THE DEFECT. This hook delivers its whole checking program to the interpreter
# as a heredoc. Under the MSYS2 build of dash a heredoc above 4096 DELIVERED
# bytes arrives as ZERO bytes, so `python -` reads an empty program - valid
# Python - does nothing, exits 0, and the old `exit $?` propagated that 0
# faithfully. Every check in this file passed silently. MEASURED on the tracked
# hook: the trailer, the em dash, the over-long subject, the placeholder and the
# empty message ALL exited 0 with COMPLETELY EMPTY STDERR under that dash, while
# all five refused correctly under bash. Delivery bisect: 4051 delivered bytes
# arrive intact, 4097 arrive as zero.
#
# THE SEVERITY IS NARROWER THAN IT LOOKS AND THIS COMMENT DOES NOT OVERSTATE IT.
# The affected dash links msys-2.0.dll; the zero-byte delivery is a property of
# MSYS2 fork emulation, not of dash generally. On Ubuntu CI /bin/sh IS dash and
# tests/test_commit_msg_gate.py drives real commits through this hook and passes
# every violation class - CS-702 IS ENFORCED THERE. On this machine /bin/sh is
# bash, so git never invokes the affected dash here either. The defect is LATENT
# rather than live, and the guard is here because a gate that can exit 0 with
# empty stderr is unacceptable however few shells trigger it.
#
# WHY A SENTINEL RATHER THAN A SIZE GUARD. 4096 is one dash build's property, and
# an assertion about the body's length is a proxy for the property rather than
# the property. The sentinel asserts what actually matters - THE PROGRAM RAN TO
# COMPLETION - and so it catches every cause, including ones not yet imagined. A
# program moved into a file would fail the same way if the file were empty.
#
# PLAIN ASSIGNMENT ONLY, AND THIS IS THE MOST DANGEROUS LINE TO GET WRONG.
# `export`, `local` and `readonly` in front of this assignment each MASK $? to 0
# in both bash and dash, which would silently restore the exact fail-open this
# guard exists to close. The status check below would then never fire.
#
# NO TRAILING NEWLINE ON THE SENTINEL. Windows text mode turns a written newline
# into CR LF, and a written CR LF into CR CR LF, and command substitution does
# not fully strip that - it strips trailing newlines, leaving a CR behind. The
# comparison is EXACT rather than containment, so a stray CR would refuse every
# commit. Writing no newline removes the dependency instead of resting on it.
#
# DISCLOSED, LATENT: command substitution waits for EOF ON THE PIPE rather than
# for the child to exit, so a program that spawned a process holding stdout open
# would hang this hook rather than fail it. Measured at a bounded timeout
# returning 124. This program spawns nothing, so it cannot happen today.
cs_msg_out=""
cs_msg_out=$(cs_python - "$MSG_FILE" <<'CLOCKSPEED_COMMIT_MSG'
import os
import sys

TOOL = "clockspeed commit-msg"
LIMIT = 72
PLACEHOLDERS = frozenset(["wip", "fix", "update", "temp", "asdf", "test"])
NAMED = {
    0x2014: "U+2014 em dash",
    0x2013: "U+2013 en dash",
    0x2018: "U+2018 left smart single quote",
    0x2019: "U+2019 right smart single quote",
    0x201C: "U+201C left smart double quote",
    0x201D: "U+201D right smart double quote",
    0x00A0: "U+00A0 non-breaking space",
    0xFEFF: "U+FEFF byte order mark",
}
# CS-822: the only control bytes a message may carry, permitted BY NAME.
PERMITTED_CONTROLS = {0x09: "tab", 0x0A: "newline"}
# CS-813: git's scissors line, and the leaders core.commentChar=auto picks from.
CUT = b"------------------------ >8 ------------------------\n"
AUTO = b"#;@!$%^&|:"


def fail(reason, *extra):
    sys.stderr.write("%s: REJECTED - %s\n" % (TOOL, reason))
    for line in extra:
        sys.stderr.write("  %s\n" % line)
    sys.stderr.write("  Nothing was committed. HEAD is unchanged.\n")
    raise SystemExit(1)


def cleaned(text, leader):
    # git's stripspace: drop leader lines, trim line ends, squeeze blank runs.
    lines = []
    gap = False
    for line in text.split(b"\n"):
        if leader and line.startswith(leader):
            continue
        line = line.rstrip(b" \t\r")
        if not line:
            gap = True
            continue
        if gap and lines:
            lines.append(b"")
        gap = False
        lines.append(line)
    return lines


def cut(text, leader):
    # git's wt_status_locate_end: the exact scissors line ends the message.
    mark = b"\n" + leader + b" " + CUT
    if text.startswith(mark[1:]):
        return b""
    at = text.find(mark)
    return text if at < 0 else text[: at + 1]


def first_line(lines):
    # The subject as stored: the first line git does not treat as blank, UNTRIMMED.
    for line in lines:
        if line.strip(b" \t\r"):
            return line
    return b""


try:
    with open(sys.argv[1], "rb") as handle:
        raw = handle.read()
except OSError as exc:
    fail("could not read the commit message file: %s" % exc)

setting = os.environ.get("CLOCKSPEED_COMMIT_MSG_LEADERS")
if setting is None:
    fail("the hook did not hand this check the comment leader (CS-813).")
leaders = [b"#"]
chosen = b""
for entry in setting.split("\n"):
    if entry:
        chosen = entry.partition(" ")[2].encode("utf-8", "surrogateescape")
        if not chosen:
            fail("core.commentChar or core.commentString is set with no value.")
if chosen:
    leaders.append(chosen)
    if chosen.lower() == b"auto":
        leaders.extend(AUTO[i : i + 1] for i in range(len(AUTO)))

# Every stored image git could produce from this file (see the shell note).
images = []
for source, how in [(raw, "")] + [(cut(raw, x), ", cut at the scissors line") for x in leaders]:
    images.append(("verbatim" + how, source.split(b"\n")))
    images.append(("whitespace" + how, cleaned(source, None)))
    for leader in leaders:
        images.append(("strip" + how, cleaned(source, leader)))

if any(not b"".join(lines).strip() for _mode, lines in images):
    fail(
        "the commit message is empty or whitespace only.",
        "Write a real subject line saying what changed and why.",
    )

offenders = [(i, b) for i, b in enumerate(raw) if b > 0x7E]
if offenders:
    text = raw.decode("utf-8", "replace")
    for number, line in enumerate(text.split("\n"), 1):
        for column, char in enumerate(line, 1):
            point = ord(char)
            if point <= 0x7E:
                continue
            name = NAMED.get(point, "U+%04X" % point)
            fail(
                "non-ASCII character in the commit message.",
                "line %d, column %d: %s" % (number, column, name),
                "CONVENTIONS.md section 10 requires 7-bit ASCII in all",
                "authored content, commit messages included.",
            )
    fail("non-ASCII byte in the commit message (byte offset %d)" % offenders[0][0])

# CS-822: graded on the handed bytes, which ARE the verbatim image. A CR that
# every mode in play would trim never reaches here: on -m and -F git trims line
# ends before this hook unless the mode is verbatim, and verbatim stores the CR.
for number, line in enumerate(raw.split(b"\n"), 1):
    for column, byte in enumerate(line, 1):
        if byte < 0x20 and byte not in PERMITTED_CONTROLS:
            fail(
                "control byte in the commit message.",
                "line %d, column %d: 0x%02X" % (number, column, byte),
                "Only tab and newline are permitted below 0x20 (CS-822), and a",
                "carriage return is a control byte: save the message with LF.",
            )

for mode, lines in images:
    subject = first_line(lines).decode("ascii")
    if len(subject) > LIMIT:
        fail(
            "subject line is %d characters; the limit is %d." % (len(subject), LIMIT),
            "Subject: %s" % subject,
            "Counted as git would store it under cleanup %s (CS-813)." % mode,
            "Move the detail into the body, after a blank line.",
        )

for _mode, lines in images:
    subject = first_line(lines).decode("ascii").strip()
    if subject.rstrip(".!").strip().lower() in PLACEHOLDERS:
        fail(
            "subject %r is a bare placeholder." % subject,
            "Banned as an entire subject: " + ", ".join(sorted(PLACEHOLDERS)),
            "Say what changed and why; the log is read by future you.",
        )

# Modelled on git's own trailer parser, not on a string prefix. git finds
# the separator FIRST and trims the token AFTERWARDS, so "Co-authored-by :"
# is a trailer to git; and it refuses whitespace before the token has
# begun, so an indented line is not a trailer to git at any position. Both
# facts are measured, and both are load-bearing: matching a bare prefix was
# simultaneously too narrow to catch the first and too wide to allow the
# second, which is how this repository came to reject its own examples.
TRAILER = "co-authored-by"
for _mode, lines in images:
    for number, line in enumerate(b"\n".join(lines).decode("ascii").split("\n"), 1):
        token, separator, _rest = line.partition(":")
        if separator and token.rstrip().lower() == TRAILER:
            fail(
                "co-authorship trailer on line %d of the message body." % number,
                "Line: %s" % line.strip(),
                "This repository records NO co-author trailer - not for an agent,",
                "and not for a human. The rule is in docs/GATED.md; the gate is",
                "CS-702. The match is name-free ON PURPOSE: a name list would fail",
                "open on the next harness or model rename.",
                "TO QUOTE THE SHAPE instead of recording one, INDENT the line by",
                "one space: git reads no trailer in an indented line, so this gate",
                "does not either. A token sitting mid-sentence is fine as well.",
            )

# CS-819 completion sentinel. The ONLY thing this program writes to stdout, and
# it is written here - after every check has had its chance to reject - so that
# reaching it means the whole program ran. NO TRAILING NEWLINE: see the shell
# comment above the capture for why a newline cannot be trusted here.
sys.stdout.write("clockspeed-commit-msg-ran")
raise SystemExit(0)
CLOCKSPEED_COMMIT_MSG
) || exit $?

if [ "$cs_msg_out" != "clockspeed-commit-msg-ran" ]; then
    die "the message check DID NOT RUN, so this message was never verified." \
        "The check program produced no completion sentinel." \
        "Observed stdout, verbatim: [$cs_msg_out]" \
        "CS-819: under the MSYS2 build of dash, a heredoc above 4096 DELIVERED" \
        "bytes arrives as ZERO bytes. 'python -' then reads an EMPTY program," \
        "which is valid Python, does nothing, and exits 0 - so every check in" \
        "this hook passes silently and this hook exits 0 with empty stderr." \
        "Zero bytes rather than truncation is what makes it fail OPEN: a" \
        "truncated program would raise a SyntaxError and fail loudly." \
        "Re-run under a shell that delivers the whole body. Neither shell that" \
        "matters here is affected - /bin/sh is bash on this machine and dash on" \
        "Ubuntu CI, and the Ubuntu one delivers the body intact." \
        "The commit is BLOCKED: an unrun check is not a passed check."
fi

exit 0
