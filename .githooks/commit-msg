#!/bin/sh
# Clockspeed commit-msg hook - message hygiene (CONVENTIONS.md section 8).
#
# Rejects a message that is empty or whitespace only, carries any byte above
# 0x7E, has a subject line longer than 72 characters, or is a bare placeholder
# used as the entire subject.
#
# LF line endings, no BOM - see the note in .githooks/pre-commit.
#
# The message file is read as BYTES. The checks live in one inline python
# program rather than in sh because sh cannot inspect bytes portably, and
# because the interpreter has to be resolved here anyway (no hardcoded path).

set -u

die() {
    printf 'clockspeed commit-msg: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '  %s\n' "$line" >&2
    done
    exit 1
}

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    die "no commit message file was passed to the hook."
fi

CS_PY=""
CS_PY_ARG=""

# THE PROBE PROVES THE CANDIDATE BOTH RUNS A PROGRAM AND CAN REPORT ITS FAILURE.
#
# CS-703: the previous probe ran the candidate with -c and read only its exit
# status, so `true`, `:` and `echo` all passed it. The heredoc or the gate
# invocation was then handed to that program, which ignored it and exited 0, and
# the hook reported success - one environment variable silently disarmed the
# character-set gate, the secret scan, the message checks and the pre-push suite
# at once. An unrunnable check is not a passed check, and neither is a check
# handed to something that cannot run it.
#
# THE SECOND HALF EXISTS BECAUSE THE GATES READ A CHANNEL THE FIRST HALF NEVER
# VALIDATES. Every gate decision in every one of these hooks is taken from `$?`.
# A probe that compares only stdout therefore proves the candidate RAN the
# program and says nothing about whether it can REPORT a failure - so a wrapper
# that forwards stdout faithfully and drops the exit status answers the first
# half with the exact token and turns all three tier-0 gates into no-ops. Two
# ordinary shapes do exactly that, and neither is purpose-built nor knows the
# token: a POSIX wrapper ending in `| cat`, because a pipeline's status is its
# LAST command's, and a Windows .cmd shim wrapping its body in `setlocal` /
# `endlocal`, because `endlocal` resets ERRORLEVEL. The second half hands the
# candidate a program that exits 97 and demands 97 back. The sentinel avoids 0,
# 1, 2 and 5, which are ordinary results, and 125, 126 and 127, which `env` and
# the shell itself produce on an exec failure - so a candidate that never ran the
# program cannot answer correctly by accident.
#
# THAT ESCAPE WAS REACHABLE THROUGH THE `python` RUNG WITH NO ENVIRONMENT
# VARIABLE SET AT ALL. It was never a CLOCKSPEED_PYTHON problem, and unsetting
# that variable was never a mitigation for it.
#
# THE TOKEN IS ASSEMBLED FROM THREE PIECES at run time, so the string being
# compared never appears literally in the program text the candidate is handed.
# A candidate that merely echoes its arguments back cannot reproduce it by
# accident, and `echo` is the live example of one that tries.
#
# THE COMPARISON IS EXACT RATHER THAN CONTAINMENT, deliberately. Exact equality
# refuses a candidate whose stdout carries anything extra - a sitecustomize that
# prints, a .cmd shim without `@echo off`, PYTHONIOENCODING=utf-8-sig - and each
# of those is a FALSE REFUSAL this accepts knowingly. Containment would accept
# all three, and would also accept any program that emits the token among other
# output. In a gate a LOUD FALSE REFUSAL beats a SILENT FALSE ACCEPT: the
# message below fixes the first in a minute, and the second is the defect that
# made this item exist.
#
# THE TOKEN CARRIES NO TRAILING NEWLINE, so the comparison never depends on how
# the interpreter and the shell each treat a line terminator. Measured here:
# python writes CR LF to a pipe and this bash strips both, so the newline form
# happens to compare equal on THIS toolchain - exactly the version-specific
# tolerance CONVENTIONS.md section 16 says to re-measure rather than inherit.
# Writing no newline removes the dependency instead of resting on it.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY. It catches a
# MISCONFIGURED interpreter, which is what CS-703 was. It stops nobody who means
# to get past it: a program written on purpose to print the token and exit 97
# passes both halves, and `git commit --no-verify` skips every hook here without
# needing to. Never cite this probe as evidence that a commit was checked.
CS_PROBE_PROGRAM='import sys; sys.stdout.write("clockspeed-" + "python-" + "ok")'
CS_PROBE_EXPECTED='clockspeed-python-ok'
CS_PROBE_EXIT_PROGRAM='import sys; sys.exit(97)'
CS_PROBE_EXIT_EXPECTED=97

cs_probe() {
    # BOTH initialised BEFORE first use. The failure path below renders each of
    # them, and `set -u` would abort the hook on an unset one instead. The exit
    # code starts as a WORD rather than a number on purpose: a refusal that never
    # reached the second half must not be readable as "the candidate returned 0".
    cs_probe_out=""
    cs_probe_code="not reached"
    if [ -n "${2:-}" ]; then
        cs_probe_out=$("$1" "$2" -c "$CS_PROBE_PROGRAM" 2>/dev/null </dev/null) || return 1
    else
        cs_probe_out=$("$1" -c "$CS_PROBE_PROGRAM" 2>/dev/null </dev/null) || return 1
    fi
    [ "$cs_probe_out" = "$CS_PROBE_EXPECTED" ] || return 1
    # THE EXIT-STATUS HALF. $? is captured IMMEDIATELY on the next line, because
    # any command in between - a `[` included - overwrites it.
    if [ -n "${2:-}" ]; then
        "$1" "$2" -c "$CS_PROBE_EXIT_PROGRAM" >/dev/null 2>&1 </dev/null
        cs_probe_code=$?
    else
        "$1" -c "$CS_PROBE_EXIT_PROGRAM" >/dev/null 2>&1 </dev/null
        cs_probe_code=$?
    fi
    # Compared as STRINGS. Both sides are literal digits here, and `=` cannot
    # raise on a non-numeric value the way `-eq` would.
    [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ]
}

# One dispatcher, so the python program below exists exactly once.
cs_python() {
    if [ -n "$CS_PY_ARG" ]; then
        "$CS_PY" "$CS_PY_ARG" "$@"
    else
        "$CS_PY" "$@"
    fi
}

if [ -n "${CLOCKSPEED_PYTHON:-}" ]; then
    # SET BUT FAILING IS A HARD FAILURE, NOT A FALL-THROUGH. The old form was
    # one `&&` condition, so a value that failed the probe fell quietly through
    # to `python`: the operator's explicit choice was overruled, the run
    # continued under an interpreter they did not pick, and nothing said so.
    # That is the CS-806 shape in a quieter form. Refusing costs one loud
    # message; falling through costs silence.
    if cs_probe "$CLOCKSPEED_PYTHON"; then
        CS_PY="$CLOCKSPEED_PYTHON"
    else
        # Flattened to ONE line and capped, so a candidate that ignores its
        # arguments and prints without limit cannot flood the terminal. The
        # VALUE of CLOCKSPEED_PYTHON is deliberately NOT echoed back: it is
        # routinely an absolute path under a home directory, and this text
        # reaches logs and reports (CLAUDE.md non-negotiable 3).
        cs_probe_flat=$(printf '%s' "$cs_probe_out" | tr '\r\n' '  ' 2>/dev/null)
        cs_probe_shown=$(printf '%.200s' "$cs_probe_flat")
        die "CLOCKSPEED_PYTHON is set but did not answer the probe." \
            "It must name ONE EXECUTABLE, not a command line with arguments." \
            "'py -3' is two tokens, so it cannot be this variable's value. Unset" \
            "the variable and the ladder reaches 'py -3' by itself, last." \
            "Observed probe output, truncated to 200 characters:" \
            "[$cs_probe_shown]" \
            "Observed exit status when asked to fail: [$cs_probe_code]" \
            "(expected $CS_PROBE_EXIT_EXPECTED; 'not reached' means this half" \
            "never ran. That happens BOTH when the candidate could not be" \
            "executed at all AND when it ran but answered the output check" \
            "wrongly - empty output above points at the first.)" \
            "An interpreter must BOTH run the program it is handed AND report a" \
            "failure back. That is CS-703: judging the exit code alone let 'true'," \
            "':' and 'echo' through, and judging stdout alone let a wrapper that" \
            "forwards output but drops the exit status turn every tier-0 gate" \
            "into a no-op." \
            "Point CLOCKSPEED_PYTHON at a working python executable, or unset it." \
            "The commit is BLOCKED: an unrunnable check is not a passed check."
    fi
elif cs_probe python; then
    CS_PY="python"
elif cs_probe python3; then
    CS_PY="python3"
elif cs_probe py -3; then
    CS_PY="py"
    CS_PY_ARG="-3"
else
    die "no usable python interpreter found." \
        "Tried \$CLOCKSPEED_PYTHON, 'python', 'python3', 'py -3'." \
        "Set CLOCKSPEED_PYTHON to an interpreter and retry." \
        "The commit is BLOCKED: an unrunnable check is not a passed check."
fi

# THE PROGRAM MUST PROVE IT RAN. CS-819.
#
# THE DEFECT. This hook delivers its whole checking program to the interpreter
# as a heredoc. Under the MSYS2 build of dash a heredoc above 4096 DELIVERED
# bytes arrives as ZERO bytes, so `python -` reads an empty program - valid
# Python - does nothing, exits 0, and the old `exit $?` propagated that 0
# faithfully. Every check in this file passed silently. MEASURED on the tracked
# hook: the trailer, the em dash, the over-long subject, the placeholder and the
# empty message ALL exited 0 with COMPLETELY EMPTY STDERR under that dash, while
# all five refused correctly under bash. Delivery bisect: 4051 delivered bytes
# arrive intact, 4097 arrive as zero.
#
# THE SEVERITY IS NARROWER THAN IT LOOKS AND THIS COMMENT DOES NOT OVERSTATE IT.
# The affected dash links msys-2.0.dll; the zero-byte delivery is a property of
# MSYS2 fork emulation, not of dash generally. On Ubuntu CI /bin/sh IS dash and
# tests/test_commit_msg_gate.py drives real commits through this hook and passes
# every violation class - CS-702 IS ENFORCED THERE. On this machine /bin/sh is
# bash, so git never invokes the affected dash here either. The defect is LATENT
# rather than live, and the guard is here because a gate that can exit 0 with
# empty stderr is unacceptable however few shells trigger it.
#
# WHY A SENTINEL RATHER THAN A SIZE GUARD. 4096 is one dash build's property, and
# an assertion about the body's length is a proxy for the property rather than
# the property. The sentinel asserts what actually matters - THE PROGRAM RAN TO
# COMPLETION - and so it catches every cause, including ones not yet imagined. A
# program moved into a file would fail the same way if the file were empty.
#
# PLAIN ASSIGNMENT ONLY, AND THIS IS THE MOST DANGEROUS LINE TO GET WRONG.
# `export`, `local` and `readonly` in front of this assignment each MASK $? to 0
# in both bash and dash, which would silently restore the exact fail-open this
# guard exists to close. The status check below would then never fire.
#
# NO TRAILING NEWLINE ON THE SENTINEL. Windows text mode turns a written newline
# into CR LF, and a written CR LF into CR CR LF, and command substitution does
# not fully strip that - it strips trailing newlines, leaving a CR behind. The
# comparison is EXACT rather than containment, so a stray CR would refuse every
# commit. Writing no newline removes the dependency instead of resting on it.
#
# DISCLOSED, LATENT: command substitution waits for EOF ON THE PIPE rather than
# for the child to exit, so a program that spawned a process holding stdout open
# would hang this hook rather than fail it. Measured at a bounded timeout
# returning 124. This program spawns nothing, so it cannot happen today.
cs_msg_out=""
cs_msg_out=$(cs_python - "$MSG_FILE" <<'CLOCKSPEED_COMMIT_MSG'
import sys

TOOL = "clockspeed commit-msg"
LIMIT = 72
PLACEHOLDERS = frozenset(["wip", "fix", "update", "temp", "asdf", "test"])
NAMED = {
    0x2014: "U+2014 em dash",
    0x2013: "U+2013 en dash",
    0x2018: "U+2018 left smart single quote",
    0x2019: "U+2019 right smart single quote",
    0x201C: "U+201C left smart double quote",
    0x201D: "U+201D right smart double quote",
    0x00A0: "U+00A0 non-breaking space",
    0xFEFF: "U+FEFF byte order mark",
}


def fail(reason, *extra):
    sys.stderr.write("%s: REJECTED - %s\n" % (TOOL, reason))
    for line in extra:
        sys.stderr.write("  %s\n" % line)
    sys.stderr.write("  Nothing was committed. HEAD is unchanged.\n")
    raise SystemExit(1)


try:
    with open(sys.argv[1], "rb") as handle:
        raw = handle.read()
except OSError as exc:
    fail("could not read the commit message file: %s" % exc)

# Strip git's comment lines and everything past a scissors marker, so the
# template and any --verbose diff are not mistaken for the message.
kept = []
for line in raw.split(b"\n"):
    stripped = line.rstrip(b"\r")
    if stripped.startswith(b"#"):
        if b">8" in stripped:
            break
        continue
    kept.append(stripped)
body = b"\n".join(kept)

if not body.strip():
    fail(
        "the commit message is empty or whitespace only.",
        "Write a real subject line saying what changed and why.",
    )

offenders = [(i, b) for i, b in enumerate(body) if b > 0x7E]
if offenders:
    text = body.decode("utf-8", "replace")
    for number, line in enumerate(text.split("\n"), 1):
        for column, char in enumerate(line, 1):
            point = ord(char)
            if point <= 0x7E:
                continue
            name = NAMED.get(point, "U+%04X" % point)
            fail(
                "non-ASCII character in the commit message.",
                "line %d, column %d: %s" % (number, column, name),
                "CONVENTIONS.md section 10 requires 7-bit ASCII in all",
                "authored content, commit messages included.",
            )
    fail("non-ASCII byte in the commit message (byte offset %d)" % offenders[0][0])

subject = ""
for line in body.decode("ascii").split("\n"):
    if line.strip():
        subject = line.strip()
        break

if len(subject) > LIMIT:
    fail(
        "subject line is %d characters; the limit is %d." % (len(subject), LIMIT),
        "Subject: %s" % subject,
        "Move the detail into the body, after a blank line.",
    )

if subject.rstrip(".!").strip().lower() in PLACEHOLDERS:
    fail(
        "subject %r is a bare placeholder." % subject,
        "Banned as an entire subject: " + ", ".join(sorted(PLACEHOLDERS)),
        "Say what changed and why; the log is read by future you.",
    )

# Modelled on git's own trailer parser, not on a string prefix. git finds
# the separator FIRST and trims the token AFTERWARDS, so "Co-authored-by :"
# is a trailer to git; and it refuses whitespace before the token has
# begun, so an indented line is not a trailer to git at any position. Both
# facts are measured, and both are load-bearing: matching a bare prefix was
# simultaneously too narrow to catch the first and too wide to allow the
# second, which is how this repository came to reject its own examples.
TRAILER = "co-authored-by"
for number, line in enumerate(body.decode("ascii").split("\n"), 1):
    token, separator, _rest = line.partition(":")
    if separator and token.rstrip().lower() == TRAILER:
        fail(
            "co-authorship trailer on line %d of the message body." % number,
            "Line: %s" % line.strip(),
            "This repository records NO co-author trailer - not for an agent,",
            "and not for a human. The rule is in docs/GATED.md; the gate is",
            "CS-702. The match is name-free ON PURPOSE: a name list would fail",
            "open on the next harness or model rename.",
            "TO QUOTE THE SHAPE instead of recording one, INDENT the line by",
            "one space: git reads no trailer in an indented line, so this gate",
            "does not either. A token sitting mid-sentence is fine as well.",
        )

# CS-819 completion sentinel. The ONLY thing this program writes to stdout, and
# it is written here - after every check has had its chance to reject - so that
# reaching it means the whole program ran. NO TRAILING NEWLINE: see the shell
# comment above the capture for why a newline cannot be trusted here.
sys.stdout.write("clockspeed-commit-msg-ran")
raise SystemExit(0)
CLOCKSPEED_COMMIT_MSG
) || exit $?

if [ "$cs_msg_out" != "clockspeed-commit-msg-ran" ]; then
    die "the message check DID NOT RUN, so this message was never verified." \
        "The check program produced no completion sentinel." \
        "Observed stdout, verbatim: [$cs_msg_out]" \
        "CS-819: under the MSYS2 build of dash, a heredoc above 4096 DELIVERED" \
        "bytes arrives as ZERO bytes. 'python -' then reads an EMPTY program," \
        "which is valid Python, does nothing, and exits 0 - so every check in" \
        "this hook passes silently and this hook exits 0 with empty stderr." \
        "Zero bytes rather than truncation is what makes it fail OPEN: a" \
        "truncated program would raise a SyntaxError and fail loudly." \
        "Re-run under a shell that delivers the whole body. Neither shell that" \
        "matters here is affected - /bin/sh is bash on this machine and dash on" \
        "Ubuntu CI, and the Ubuntu one delivers the body intact." \
        "The commit is BLOCKED: an unrun check is not a passed check."
fi

exit 0
