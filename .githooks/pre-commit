#!/bin/sh
# Clockspeed pre-commit hook - tier 0, authoritative (CONVENTIONS.md section 8).
#
# Runs tools/precommit_gate.py --staged, which reads the bytes FROM THE INDEX,
# not from the working tree, and exits with the gate's own exit code.
#
# LINE ENDINGS. This file must be LF with no BOM. .gitattributes pins
# .githooks/* to eol=lf and scripts/install_hooks.py verifies it on every run.
#
# MEASURED 2026-08-13, git 2.53.0.windows.3 / GNU bash 5.2.37(1) msys: the
# bundled bash RUNS a CRLF hook correctly - same stdout, same exit code as the
# LF original, verified by executing both. So on THIS toolchain a CRLF hook
# does NOT silently do nothing, and an em dash staged against a CRLF-converted
# pre-commit was still blocked end to end.
#
# LF is still mandatory, for two reasons that survive that measurement:
#   1. Other shells are stricter. dash, ash and older msys releases fail the
#      shebang on a trailing \r, and CI tier 2 runs this hook on a POSIX
#      runner. The trap is real off this machine.
#   2. CONVENTIONS.md section 16 is explicit that hook findings are
#      version-specific and expire. Re-measure; never inherit. Do not relax
#      the check because one bash release happens to be tolerant.
#
# No interpreter path is hardcoded. Resolution order is $CLOCKSPEED_PYTHON,
# then `python`, then `python3`, then `py -3`. If none of them works this hook
# FAILS LOUDLY with a non-zero exit - it never waves the commit through.
#
# `py -3` IS DELIBERATELY LAST. See BOOTSTRAP.md section 2.5: on this machine the
# launcher's default 3.14 is a different installation from the one on PATH, and it
# carries no ruff and no pytest. Both report 3.14.4, so a version check passes while
# the lint step silently degrades and the pre-push suite cannot run at all. Ordering
# `py -3` first is how a correctly wired hook ends up doing nothing.

set -u

die() {
    printf 'clockspeed pre-commit: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '  %s\n' "$line" >&2
    done
    exit 1
}

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
if [ -z "$ROOT" ]; then
    die "not inside a git work tree; refusing to run."
fi

GATE="$ROOT/tools/precommit_gate.py"
if [ ! -f "$GATE" ]; then
    die "gate not found at $GATE" \
        "The hook is wired but the engine is missing." \
        "Restore tools/precommit_gate.py before committing."
fi

CS_PY=""
CS_PY_ARG=""

# THE PROBE PROVES THE CANDIDATE BOTH RUNS A PROGRAM AND CAN REPORT ITS FAILURE.
#
# CS-703: the previous probe ran the candidate with -c and read only its exit
# status, so `true`, `:` and `echo` all passed it. The heredoc or the gate
# invocation was then handed to that program, which ignored it and exited 0, and
# the hook reported success - one environment variable silently disarmed the
# character-set gate, the secret scan, the message checks and the pre-push suite
# at once. An unrunnable check is not a passed check, and neither is a check
# handed to something that cannot run it.
#
# THE SECOND HALF EXISTS BECAUSE THE GATES READ A CHANNEL THE FIRST HALF NEVER
# VALIDATES. Every gate decision in every one of these hooks is taken from `$?`.
# A probe that compares only stdout therefore proves the candidate RAN the
# program and says nothing about whether it can REPORT a failure - so a wrapper
# that forwards stdout faithfully and drops the exit status answers the first
# half with the exact token and turns all three tier-0 gates into no-ops. Two
# ordinary shapes do exactly that, and neither is purpose-built nor knows the
# token: a POSIX wrapper ending in `| cat`, because a pipeline's status is its
# LAST command's, and a Windows .cmd shim wrapping its body in `setlocal` /
# `endlocal`, because `endlocal` resets ERRORLEVEL. The second half hands the
# candidate a program that exits 97 and demands 97 back. The sentinel avoids 0,
# 1, 2 and 5, which are ordinary results, and 125, 126 and 127, which `env` and
# the shell itself produce on an exec failure - so a candidate that never ran the
# program cannot answer correctly by accident.
#
# THAT ESCAPE WAS REACHABLE THROUGH THE `python` RUNG WITH NO ENVIRONMENT
# VARIABLE SET AT ALL. It was never a CLOCKSPEED_PYTHON problem, and unsetting
# that variable was never a mitigation for it.
#
# THE TOKEN IS ASSEMBLED FROM THREE PIECES at run time, so the string being
# compared never appears literally in the program text the candidate is handed.
# A candidate that merely echoes its arguments back cannot reproduce it by
# accident, and `echo` is the live example of one that tries.
#
# THE COMPARISON IS EXACT RATHER THAN CONTAINMENT, deliberately. Exact equality
# refuses a candidate whose stdout carries anything extra - a sitecustomize that
# prints, a .cmd shim without `@echo off`, PYTHONIOENCODING=utf-8-sig - and each
# of those is a FALSE REFUSAL this accepts knowingly. Containment would accept
# all three, and would also accept any program that emits the token among other
# output. In a gate a LOUD FALSE REFUSAL beats a SILENT FALSE ACCEPT: the
# message below fixes the first in a minute, and the second is the defect that
# made this item exist.
#
# THE TOKEN CARRIES NO TRAILING NEWLINE, so the comparison never depends on how
# the interpreter and the shell each treat a line terminator. Measured here:
# python writes CR LF to a pipe and this bash strips both, so the newline form
# happens to compare equal on THIS toolchain - exactly the version-specific
# tolerance CONVENTIONS.md section 16 says to re-measure rather than inherit.
# Writing no newline removes the dependency instead of resting on it.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY. It catches a
# MISCONFIGURED interpreter, which is what CS-703 was. It stops nobody who means
# to get past it: a program written on purpose to print the token and exit 97
# passes both halves, and `git commit --no-verify` skips every hook here without
# needing to. Never cite this probe as evidence that a commit was checked.
CS_PROBE_PROGRAM='import sys; sys.stdout.write("clockspeed-" + "python-" + "ok")'
CS_PROBE_EXPECTED='clockspeed-python-ok'
CS_PROBE_EXIT_PROGRAM='import sys; sys.exit(97)'
CS_PROBE_EXIT_EXPECTED=97
CS_PROBE_BOUND=10
CS_PROBE_CAPTURE='cs_o=$("$@"); cs_r=$?; printf "%s" "$cs_o"; exit "$cs_r"'

cs_probe() {
    # ALL initialised BEFORE first use. The failure paths below render them,
    # and `set -u` would abort the hook on an unset one instead. The exit code
    # starts as a WORD rather than a number on purpose: a refusal that never
    # reached the second half must not be readable as "the candidate returned 0".
    cs_probe_out=""
    cs_probe_code="not reached"
    cs_probe_rc="not reached"
    cs_probe_bound_ok=""
    # CS-816: EVERY HALF OF THIS PROBE RUNS UNDER A BOUND OF CS_PROBE_BOUND
    # SECONDS, AND A HALF THAT DOES NOT RETURN INSIDE IT REFUSES THE HOOK.
    # Three hang shapes were measured, none of them exotic. PYTHONINSPECT=1
    # goes interactive after the program, because under MSYS /dev/null is the
    # NUL character device and reports a tty. A candidate that leaves a
    # background process holding stdout makes a command substitution wait for
    # that process rather than for the candidate. A wrapper that execs python
    # with stdin from /dev/null answers every -c program and then spins on a
    # program handed to it on stdin. The answer is a BOUND rather than an
    # enumeration of causes, and so the probe also hands the candidate one
    # program on stdin - the shape commit-msg delivers its checker in - and
    # grades only that it RETURNS.
    #
    # THE BOUND IS ONE LITERAL, byte-identical in the three hooks and never read
    # from the environment or a config file. Its value is justified against a
    # cold-start measurement in the closing record of CS-816 in docs/LEDGER.md.
    #
    # A TIMED-OUT PROBE NEVER FALLS THROUGH to the next rung. The last rung is
    # 'py -3', the measured interpreter that carries no toolchain, and a probe
    # that timed out and then proceeded is the CS-703 no-op wearing a clock. An
    # ordinary MISMATCH still falls through exactly as it always did.
    #
    # THE BOUNDING BINARY IS CHECKED BY BEHAVIOUR, NEVER BY NAME. On Windows,
    # System32 carries a 'timeout' that is a pause command with unrelated
    # semantics, behind GNU timeout on PATH. Before any candidate runs, the
    # binary must pass an ordinary exit status straight through AND return 124
    # when a short bound expires. Absent, foreign, or never expiring, it refuses
    # the hook: a probe is never run without a time limit.
    timeout -k 1 "$CS_PROBE_BOUND" sh -c 'exit 42' </dev/null >/dev/null 2>&1
    if [ "$?" = 42 ]; then
        timeout -k 1 0.2 sleep 5 </dev/null >/dev/null 2>&1
        if [ "$?" = 124 ]; then
            cs_probe_bound_ok="yes"
        fi
    fi
    if [ "$cs_probe_bound_ok" != "yes" ]; then
        die "no working GNU timeout was found, so the interpreter probe cannot be bounded." \
            "The hook refuses rather than run a probe with no time limit (CS-816)." \
            "'timeout' is checked by behaviour: it must pass an ordinary exit status" \
            "through and return 124 when its bound expires. A different program of" \
            "the same name, such as the Windows pause command, fails that check." \
            "Fix: put GNU coreutils 'timeout' and 'sleep' first on PATH. Git for" \
            "Windows ships both in its own usr/bin directory." \
            "BLOCKED: an unbounded probe is not a passed probe."
    fi
    # THE CAPTURE RUNS INSIDE THE BOUNDED PROCESS. CS_PROBE_CAPTURE is a small sh
    # program that takes the candidate's output itself and re-emits it, so the
    # only processes holding THIS substitution's pipe are ones the bound kills.
    # Capturing the candidate here directly would let a background process it
    # left behind hold the pipe after the bounded child exited, and this
    # substitution would wait on that process with no limit at all.
    #
    # THE EXIT STATUS IS GRADED BEFORE THE TOKEN. MEASURED under a 3 second
    # bound: PYTHONINSPECT=1 returned 124 while the capture already held the
    # exact token. 124 is the bound expiring, 137 the KILL sent when a candidate
    # ignored TERM, and 143 a TERM from elsewhere. Each refuses, whatever the
    # capture holds.
    cs_probe_out=$(timeout -k 1 "$CS_PROBE_BOUND" sh -c "$CS_PROBE_CAPTURE" \
        cs_probe "$@" -c "$CS_PROBE_PROGRAM" 2>/dev/null </dev/null)
    cs_probe_rc=$?
    if [ "$cs_probe_rc" = 0 ] && [ "$cs_probe_out" = "$CS_PROBE_EXPECTED" ]; then
        # THE EXIT-STATUS HALF. $? is captured IMMEDIATELY on the next line,
        # because any command in between - a `[` included - overwrites it.
        timeout -k 1 "$CS_PROBE_BOUND" sh -c "$CS_PROBE_CAPTURE" \
            cs_probe "$@" -c "$CS_PROBE_EXIT_PROGRAM" >/dev/null 2>&1 </dev/null
        cs_probe_rc=$?
        cs_probe_code=$cs_probe_rc
        if [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ]; then
            # THE STDIN HALF grades only that the candidate RETURNS inside the
            # bound. Its output and its status are deliberately not compared:
            # this half exists for the hang, and a stricter grade here would
            # refuse candidates that the two halves above already judge.
            printf '%s' "$CS_PROBE_PROGRAM" | timeout -k 1 "$CS_PROBE_BOUND" \
                sh -c "$CS_PROBE_CAPTURE" cs_probe "$@" - >/dev/null 2>&1
            cs_probe_rc=$?
        fi
    fi
    case "$cs_probe_rc" in
        124|137|143)
            die "the interpreter probe did not answer within $CS_PROBE_BOUND seconds." \
                "Observed status: [$cs_probe_rc] (124 is the bound expiring)." \
                "A probe that times out REFUSES and never falls through to the next" \
                "rung: the last rung, 'py -3', is the measured interpreter that" \
                "carries no toolchain (CS-816)." \
                "Known causes: PYTHONINSPECT set in the environment; an interpreter" \
                "wrapper that redirects stdin from /dev/null; a wrapper that leaves a" \
                "background process holding stdout." \
                "Unset PYTHONINSPECT, or point CLOCKSPEED_PYTHON at a plain python." \
                "BLOCKED: an unanswered probe is not a passed probe."
            ;;
    esac
    # Compared as STRINGS. Both sides are literal digits here, and `=` cannot
    # raise on a non-numeric value the way `-eq` would.
    [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ]
}

cs_python() {
    if [ -n "$CS_PY_ARG" ]; then
        "$CS_PY" "$CS_PY_ARG" "$@"
    else
        "$CS_PY" "$@"
    fi
}

# >>> CS-818 LADDER BEGIN - resolves CS_PY and CS_PY_ARG; pinned across the hooks.
if [ -n "${CLOCKSPEED_PYTHON:-}" ]; then
    # SET BUT FAILING IS A HARD FAILURE, NOT A FALL-THROUGH. The old form was
    # one `&&` condition, so a value that failed the probe fell quietly through
    # to `python`: the operator's explicit choice was overruled, the run
    # continued under an interpreter they did not pick, and nothing said so.
    # That is the CS-806 shape in a quieter form. Refusing costs one loud
    # message; falling through costs silence.
    if cs_probe "$CLOCKSPEED_PYTHON"; then
        CS_PY="$CLOCKSPEED_PYTHON"
    else
        # Flattened to ONE line and capped, so a candidate that ignores its
        # arguments and prints without limit cannot flood the terminal. The
        # VALUE of CLOCKSPEED_PYTHON is deliberately NOT echoed back: it is
        # routinely an absolute path under a home directory, and this text
        # reaches logs and reports (CLAUDE.md non-negotiable 3).
        cs_probe_flat=$(printf '%s' "$cs_probe_out" | tr '\r\n' '  ' 2>/dev/null)
        cs_probe_shown=$(printf '%.200s' "$cs_probe_flat")
        die "CLOCKSPEED_PYTHON is set but did not answer the probe." \
            "It must name ONE EXECUTABLE, not a command line with arguments." \
            "'py -3' is two tokens, so it cannot be this variable's value. Unset" \
            "the variable and the ladder reaches 'py -3' by itself, last." \
            "Observed probe output, truncated to 200 characters:" \
            "[$cs_probe_shown]" \
            "Observed exit status when asked to fail: [$cs_probe_code]" \
            "(expected $CS_PROBE_EXIT_EXPECTED; 'not reached' means this half" \
            "never ran. That happens BOTH when the candidate could not be" \
            "executed at all AND when it ran but answered the output check" \
            "wrongly - empty output above points at the first.)" \
            "An interpreter must BOTH run the program it is handed AND report a" \
            "failure back. That is CS-703: judging the exit code alone let 'true'," \
            "':' and 'echo' through, and judging stdout alone let a wrapper that" \
            "forwards output but drops the exit status turn every tier-0 gate" \
            "into a no-op." \
            "Point CLOCKSPEED_PYTHON at a working python executable, or unset it." \
            "The commit is BLOCKED: an unrunnable gate is not a passed gate."
    fi
elif cs_probe python; then
    CS_PY="python"
elif cs_probe python3; then
    CS_PY="python3"
elif cs_probe py -3; then
    CS_PY="py"
    CS_PY_ARG="-3"
else
    die "no usable python interpreter found." \
        "Tried \$CLOCKSPEED_PYTHON, 'python', 'python3', 'py -3'." \
        "Set CLOCKSPEED_PYTHON to an interpreter and retry." \
        "The commit is BLOCKED: an unrunnable gate is not a passed gate."
fi
# <<< CS-818 LADDER END

# THE HOOK REQUIRES PROOF THE GATE RAN, NOT MERELY THAT IT EXITED 0.
#
# CS-823. The check at the top proves the gate FILE is present and the ladder
# above proves the INTERPRETER runs a program and can report a failure. NEITHER
# PROVES THE GATE EXECUTED, and two ordinary shapes exploit exactly that gap.
#
# ONE, A TRUNCATED GATE. `tools/precommit_gate.py` ends in an `if __name__ ...`
# main guard, so a copy truncated anywhere before that guard defines everything
# and executes NOTHING - python exits 0, and the old `exit $?` propagated that 0
# faithfully. MEASURED with real commits staging an em dash, the gate truncated
# in the WORKING TREE only: the intact gate refuses with exit 1, HEAD unchanged
# and 576 bytes of stderr, while truncated to 2368 lines, truncated to 1 line,
# and emptied ALL exit 0, MOVE HEAD, and write ZERO BYTES of stderr. Compiling
# every line-boundary prefix, 1020 of 2396 truncation points are syntactically
# valid - closer to a coin flip than to a corner case.
#
# TWO, AN INTERPRETER THAT ANSWERS THE PROBE AND RUNS NOTHING ELSE. The probe
# asks the candidate to run a `-c` program; the gate is invoked as a FILE. A
# wrapper that delegates `-c` faithfully therefore answers BOTH probe halves
# with the computed token and the returned 97, and still ignores the gate
# entirely. MEASURED on this hook before the repair: a four-line `sh` wrapper
# that execs the real python for `-c` and exits 0 for anything else COMMITTED a
# staged em dash - exit 0, HEAD moved, ZERO bytes of stderr - while passing the
# probe. It knows no token and is not built against the probe. CS-703 neither
# closed this nor claimed to: the probe validates the `-c` shape, and this is
# the FILE shape.
#
# THE INDEX IS NO PROTECTION, and that is what makes the first one more than a
# curiosity. This hook loads the gate from the WORKING TREE while the gate reads
# the files under test from the INDEX, so a correct committed copy does not
# help.
#
# THE PROOF IS THE GATE'S OWN SUCCESS BANNER, so nothing in the gate changes -
# it is separately frozen and outside this item's grant. The gate writes that
# banner to stdout as the LAST thing it writes on a zero exit. This captures
# stdout and, on a ZERO exit, requires the banner AS THE LAST LINE. A gate that
# never ran yields exit 0 with EMPTY stdout and is refused.
#
# THE PATTERN IS ANCHORED AT BOTH ENDS, with ONLY the two counts wild. A `case`
# pattern matches the WHOLE word, so this is not a substring search: a banner
# followed by anything, preceded by anything, or sitting mid-sentence is
# REFUSED. Exact equality is unavailable rather than declined - the banner
# embeds two counts that differ per commit, and the gate that renders them is
# frozen - so this is the strictest predicate actually reachable here. It does
# NOT relax the probe's exact-equality rule above, which compares a single fixed
# token and still does.
#
# THE CARRIAGE RETURN IS STRIPPED RATHER THAN TOLERATED. Python writes CR LF to
# a pipe on Windows, and the comment above the probe records that THIS bash
# strips both in a command substitution - which is precisely the version
# specific tolerance CONVENTIONS.md section 16 says to re-measure rather than
# inherit. Because the pattern is anchored at its END, a surviving CR would
# refuse every commit. Stripping removes the dependency instead of resting on
# it. `tr` is already used by the flood cap above, so it is no new dependency.
#
# STDERR IS DELIBERATELY NOT CAPTURED, so the gate's BLOCKED banner and all of
# its diagnostics still stream to the terminal as they are produced.
#
# THE CAPTURED STDOUT IS RE-EMITTED, NOT SWALLOWED, and this is where CS-823
# departs from CS-819 ON PURPOSE. That hook's sentinel is noise, so it is
# consumed. This gate's stdout is a REPORT: it carries the CS-209 coverage-skip
# lines, which exist to tell the operator their detection was REDUCED. Swallowing
# them would silence the one channel that says a check did not cover something.
#
# THE BLOCKED PATH REORDERS, AND THAT IS DISCLOSED RATHER THAN HIDDEN. Capturing
# one stream while the other streams live means the gate's stdout is re-emitted
# AFTER its stderr. MEASURED as line multisets over both streams: the ACCEPT
# path is SEQUENCE IDENTICAL to the pre-capture hook, and the BLOCKED path is
# identical as a MULTISET, with the CS-209 skip lines moving from before the
# BLOCKED banner to after it. NO BYTES ARE LOST on either path. The alternatives
# are worse: a pipeline makes `$?` the LAST command's status, which is the exact
# escape fenced above, and a temporary file adds lifetime and cleanup for
# nothing.
#
# PLAIN ASSIGNMENT ONLY, and this is the most dangerous line here to get wrong.
# `export`, `local` and `readonly` in front of the capture each MASK $? to 0 in
# both bash and dash, which would silently restore the exact fail-open this
# guard exists to close.
#
# DISCLOSED, LATENT: command substitution waits for EOF ON THE PIPE rather than
# for the child to exit, so a gate that spawned a process holding stdout open
# would HANG this hook rather than fail it. Both subprocess calls in the gate
# pass capture_output, so the child gets its own pipes and cannot inherit this
# one. That is the only thing standing between this capture and a hang, so it is
# pinned from the test side rather than left to a reader.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY - the same disclosure
# the probe carries above, repeated because this guard invites the same
# misreading. It catches a gate that DID NOT RUN. It stops nobody who means to
# get past it: a program written on purpose to print the banner passes it, and
# `git commit --no-verify` skips every hook here without needing to. Never cite
# this guard as evidence that a commit was checked.
CS_GATE_PASS='precommit_gate: PASS - '

# BOTH initialised BEFORE first use. The refusal below renders the last line,
# and `set -u` would abort the hook on an unset one instead.
CS_GATE_OUT=""
CS_GATE_LAST=""

# CS-955: THE GATE GRADES A SNAPSHOT OF THE INDEX, AND THE COMMIT IS REFUSED
# UNLESS WHAT GIT WILL COMMIT IS STILL EXACTLY THAT SNAPSHOT.
#
# The gate grades the index, and git builds the commit from the index it RE-READS
# after this hook returns. A stage that lands while the gate is running is
# therefore committed without ever being graded - CS-954's shape one level down.
# MEASURED before this repair with a gate stand-in: a new path, new content for a
# staged path, a mode change and a removal were each COMMITTED, exit 0, on a plain
# commit, `commit -a` and a pathspec commit alike.
#
# WHY A SNAPSHOT AND NOT TWO LIVE LISTINGS. Listing the live index before and
# after the gate was the first repair, and it was REFUTED: an entry removed while
# the gate read the index and restored before the second listing (an A-B-A
# excursion) left both listings equal, so the gate graded an index without that
# entry and git committed it ungraded. So the gate never reads the live index. The
# hook copies the index git handed it into a file only this run knows the name
# of, the gate grades THAT, and afterwards the live index must list exactly what
# the snapshot lists. A live A-B-A excursion then commits A, which is what was
# graded; anything else refuses.
#
# THE SOURCE IS `GIT_INDEX_FILE`, NEVER `.git/index`. Git hands each commit shape
# a different file and re-reads that same file after the hook: a plain commit the
# real index, `commit -a` its `index.lock`, a pathspec commit a temporary
# `next-index-*.lock`. Copying the real index on `-a` would grade the index from
# BEFORE `-a` staged anything.
#
# THE SNAPSHOT LIVES IN THE GIT DIR, from `git rev-parse --absolute-git-dir`, and
# never under TMP: MSYS rewrites POSIX paths it hands a native child, and a split
# index resolves its shared part from the git dir. `git add` cannot stage it, and
# it is never cloned or pushed. It is written by `cp` and read by `ls-files`, and
# NOTHING here writes either index - `write-tree` would rewrite the cache-tree of
# the index git is about to commit.
#
# THE EXPORT IS CONFINED TO THE GATE'S COMMAND SUBSTITUTION. The ladder above and
# the live listing below see the value git handed; only the gate and its children
# see the snapshot. A prefix assignment on the `cs_python` FUNCTION call would not
# do: POSIX leaves its persistence unspecified, and dash and bash differ.
#
# THE TRAPS REMOVE ONLY THIS RUN'S SNAPSHOT, on every exit path - a pass, the
# gate's refusal, every die, and HUP, INT or TERM, whose trap exits so that the
# EXIT trap runs (dash runs no EXIT trap on a signal death). There is no sweep of
# other snapshots: two commits in one worktree can run this hook at once. A
# SIGKILL or a power cut leaves the file behind; it holds nothing the index does
# not, and a unique name means no later run reads it.
#
# LISTINGS ARE `git ls-files -s --debug` REDUCED BY `cs_index_view`: mode, object
# id, stage and path of every entry, PLUS its index FLAGS. The flags are what
# carry intent-to-add, and `ls-files -s` alone prints the SAME line for an
# intent-to-add entry and a real empty-file entry. MEASURED: `git add -N` of an
# empty file, then a plain `git add` of it against the live index while the gate
# ran, left every `-s` listing equal and COMMITTED a file the gate never graded -
# the gate reads `diff --cached`, which hides intent-to-add entries. The ctime,
# mtime, dev, ino, uid, gid and size fields are DROPPED, because a benign refresh
# rewrites them while what git commits does not change. Refusing every commit that
# carries an intent-to-add entry was the alternative, and it lost: such an entry
# is neither graded nor committed, so it is consistent as it stands, and refusing
# it would block an ordinary `git add -N` workflow. Only a CHANGE of the bit
# between the snapshot and the live index is a defect, and this refuses exactly
# that. The listings are COMPARED EXACTLY, NOT HASHED: a hash needs a pipeline,
# whose status is its LAST command's, so a failing `ls-files` would hash to the
# same empty digest twice and PASS. The raw listing is captured by a plain
# assignment whose status is checked. Git C-quotes any path carrying a newline,
# tab, quote or backslash, so each entry header stays on one line.
#
# THE REDUCTION FAILS CLOSED. An earlier form fed its loop from a here-document,
# which bash backs with a TEMP FILE once the text outgrows a pipe buffer - every
# real listing does. Had that file failed, the loop would never run, all three
# views would come back EMPTY, compare equal, and the commit would PASS with
# nothing compared at all. So the reduction now splits its argument on newlines
# by parameter expansion in a `for` loop - no here-document, no pipeline, no temp
# file - and its status is STILL checked, and a NON-EMPTY raw listing that
# reduces to an EMPTY view refuses. An index with genuinely no entries lists
# nothing raw, and that is the only empty view accepted.
#
# DECLARED, NOT CLOSED: the window between this hook's LAST listing and git's
# re-read of the index. Nothing a hook does can close it, because git re-reads the
# index after the hook whatever the hook did. MEASURED (tests/test_precommit_index_race.py):
# on a PLAIN commit the handed index is the real one with no lock held, so an
# ordinary concurrent `git add` from another process reaches it - mid-hook that is
# refused here, and after the last listing it is not seen at all. On `commit -a`
# and a pathspec commit git holds `index.lock` for the whole hook, so an ordinary
# `git add` is refused by the lock, and only a writer that names the handed index
# file itself - a child of this hook outliving it - can reach the window.
#
# NAMED RESIDUAL, NOT DEFENDED: SNAPSHOT TAMPERING. A concurrent process that can
# write the git dir can rewrite the snapshot while the gate reads it and restore
# it before the second listing, and both snapshot listings then match. Such a
# process can equally rewrite this hook, rewrite the index after the hook exits,
# or commit with --no-verify, so a check here would stop nothing it could not step
# around. The snapshot defends against an ACCIDENTAL concurrent stage, not a
# hostile local writer.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY, like the two guards
# above it. `git commit --no-verify` skips it, as it skips every hook here.
CS_INDEX_SNAP=""
CS_INDEX_RAW=""
CS_INDEX_BEFORE=""
CS_INDEX_AFTER=""
CS_INDEX_LIVE=""

# Reduces a `git ls-files -s --debug` listing to each entry's header line and its
# flags, dropping the stat fields. It is only ever called inside a command
# substitution, so `set -f` and the newline-only IFS never reach the hook itself.
# Its failure is never trusted to be impossible: see cs_index_view_or_die.
cs_index_view() {
    set -f
    IFS='
'
    for cs_index_line in $1; do
        case "$cs_index_line" in
            "  size: "*"flags: "*)
                printf '  flags: %s\n' "${cs_index_line##*flags: }" || return 1
                ;;
            "  "*)
                ;;
            *)
                printf '%s\n' "$cs_index_line" || return 1
                ;;
        esac
    done
}

# Refuses when a reduction failed: a non-zero status, or a non-empty raw listing
# ($2) that reduced to an empty view ($3). $1 names which listing it was.
cs_index_view_or_die() {
    if [ "$CS_INDEX_STATUS" -ne 0 ] || { [ -n "$2" ] && [ -z "$3" ]; }; then
        die "the $1 listing of the index could not be reduced for comparison (status $CS_INDEX_STATUS)." \
            "An empty or failed view would compare equal to another and pass unchecked (CS-955)." \
            "The commit is BLOCKED: an index that was not compared is not graded."
    fi
}
trap 'if [ -n "$CS_INDEX_SNAP" ]; then rm -f -- "$CS_INDEX_SNAP"; fi' EXIT
trap 'exit 1' HUP INT TERM
CS_GIT_DIR=$(git rev-parse --absolute-git-dir)
CS_INDEX_STATUS=$?
if [ "$CS_INDEX_STATUS" -ne 0 ] || [ -z "$CS_GIT_DIR" ]; then
    die "the git dir could not be located for the index snapshot (git exit $CS_INDEX_STATUS)." \
        "Without a snapshot the gate cannot grade exactly what git commits (CS-955)." \
        "The commit is BLOCKED: an ungraded snapshot is not a graded index."
fi
CS_INDEX_SNAP=$(mktemp "$CS_GIT_DIR/cs-precommit-index.XXXXXXXX")
CS_INDEX_STATUS=$?
if [ "$CS_INDEX_STATUS" -ne 0 ] || [ -z "$CS_INDEX_SNAP" ]; then
    CS_INDEX_SNAP=""
    die "the index snapshot could not be created in the git dir (mktemp exit $CS_INDEX_STATUS)." \
        "Without a snapshot the gate cannot grade exactly what git commits (CS-955)." \
        "The commit is BLOCKED: an ungraded snapshot is not a graded index."
fi
CS_INDEX_SRC=${GIT_INDEX_FILE:-}
if [ -z "$CS_INDEX_SRC" ]; then
    CS_INDEX_SRC=$(git rev-parse --git-path index)
    CS_INDEX_STATUS=$?
    if [ "$CS_INDEX_STATUS" -ne 0 ] || [ -z "$CS_INDEX_SRC" ]; then
        die "the index git will commit could not be located (git exit $CS_INDEX_STATUS)." \
            "Without a snapshot the gate cannot grade exactly what git commits (CS-955)." \
            "The commit is BLOCKED: an ungraded snapshot is not a graded index."
    fi
fi
if ! cp -- "$CS_INDEX_SRC" "$CS_INDEX_SNAP"; then
    die "the index could not be copied into its snapshot." \
        "Without a snapshot the gate cannot grade exactly what git commits (CS-955)." \
        "The commit is BLOCKED: an ungraded snapshot is not a graded index."
fi
CS_INDEX_RAW=$(GIT_INDEX_FILE="$CS_INDEX_SNAP" git ls-files -s --debug)
CS_INDEX_STATUS=$?
if [ "$CS_INDEX_STATUS" -ne 0 ]; then
    die "the index snapshot could not be listed before the gate ran (git exit $CS_INDEX_STATUS)." \
        "Without that listing a stage landing mid-hook cannot be detected (CS-955)." \
        "The commit is BLOCKED: an unlisted index is not a graded index."
fi
CS_INDEX_BEFORE=$(cs_index_view "$CS_INDEX_RAW")
CS_INDEX_STATUS=$?
cs_index_view_or_die "first snapshot" "$CS_INDEX_RAW" "$CS_INDEX_BEFORE"

CS_GATE_OUT=$(GIT_INDEX_FILE="$CS_INDEX_SNAP"; export GIT_INDEX_FILE; cs_python "$GATE" --staged)
STATUS=$?

# RE-EMITTED BEFORE ANY DECISION IS TAKEN, so the gate's own stdout reaches the
# terminal on the refusal path as well as the success path. The format is FIXED
# and the capture is an ARGUMENT: `printf "$CS_GATE_OUT"` would let a percent
# sign in a skip reason or a file name corrupt the output. The emptiness guard
# is load-bearing - printf on an empty capture would print a blank line the gate
# never wrote.
if [ -n "$CS_GATE_OUT" ]; then
    printf '%s\n' "$CS_GATE_OUT"
fi

# THE NON-ZERO PATH IS UNCHANGED. The gate already refused and said why on
# stderr; this guard has nothing to add and must not replace its verdict.
if [ "$STATUS" -ne 0 ]; then
    printf 'clockspeed pre-commit: BLOCKED (gate exit %s). HEAD is unchanged.\n' \
        "$STATUS" >&2
    exit "$STATUS"
fi

# THE LAST LINE ONLY. A newline held in a variable is the portable way to ask
# for one in a parameter expansion without spawning a process. On a capture with
# no newline this yields the whole string, and on an EMPTY capture it yields the
# empty string - which is the case that matters, and which the refusal catches.
CS_NL='
'
CS_GATE_LAST=${CS_GATE_OUT##*"$CS_NL"}
CS_GATE_LAST=$(printf '%s' "$CS_GATE_LAST" | tr -d '\r')

case "$CS_GATE_LAST" in
    "$CS_GATE_PASS"[0-9]*" checked, "[0-9]*" skipped, 0 blocking")
        ;;
    *)
        die "the gate DID NOT RUN, so nothing staged was ever checked." \
            "It exited 0 without writing its own success banner as the last" \
            "line of its stdout." \
            "Expected that line to read, with the two counts varying:" \
            "[${CS_GATE_PASS}N checked, N skipped, 0 blocking]" \
            "Observed last line, verbatim: [$CS_GATE_LAST]" \
            "THREE CAUSES ARE KNOWN, and the third is the likeliest if you were" \
            "just editing the gate:" \
            "1. tools/precommit_gate.py is TRUNCATED or EMPTY in the WORKING" \
            "TREE. It ends in a __main__ guard, so a truncated copy defines" \
            "everything, executes nothing and exits 0; roughly two in five" \
            "truncation points still compile. A correct COMMITTED copy does not" \
            "help - this hook loads the gate from the working tree while the" \
            "gate reads the staged bytes from the index." \
            "2. CLOCKSPEED_PYTHON names a wrapper that answers the -c probe but" \
            "does not run a FILE it is handed. Unset it and retry." \
            "3. THE GATE'S PASS BANNER FORMAT CHANGED and this hook was not" \
            "updated with it. The two are pinned together by" \
            "tests/test_hook_interpreter_ladder.py; run that module and it will" \
            "name which side moved." \
            "The commit is BLOCKED: an unrun gate is not a passed gate."
        ;;
esac

# CS-955: THE SECOND AND THIRD LISTINGS, taken only once the gate is proven to
# have run and passed. The snapshot must still list what it listed before the
# gate, and the live index git will commit must list exactly the same. See the
# block above the gate for why.
CS_INDEX_RAW=$(GIT_INDEX_FILE="$CS_INDEX_SNAP" git ls-files -s --debug)
CS_INDEX_STATUS=$?
if [ "$CS_INDEX_STATUS" -ne 0 ]; then
    die "the index snapshot could not be listed after the gate ran (git exit $CS_INDEX_STATUS)." \
        "Without that listing a change under the gate cannot be detected (CS-955)." \
        "The commit is BLOCKED: an unlisted index is not a graded index."
fi
CS_INDEX_AFTER=$(cs_index_view "$CS_INDEX_RAW")
CS_INDEX_STATUS=$?
cs_index_view_or_die "second snapshot" "$CS_INDEX_RAW" "$CS_INDEX_AFTER"
CS_INDEX_RAW=$(git ls-files -s --debug)
CS_INDEX_STATUS=$?
if [ "$CS_INDEX_STATUS" -ne 0 ]; then
    die "the index could not be listed after the gate ran (git exit $CS_INDEX_STATUS)." \
        "Without that listing a stage landing mid-hook cannot be detected (CS-955)." \
        "The commit is BLOCKED: an unlisted index is not a graded index."
fi
CS_INDEX_LIVE=$(cs_index_view "$CS_INDEX_RAW")
CS_INDEX_STATUS=$?
cs_index_view_or_die "live" "$CS_INDEX_RAW" "$CS_INDEX_LIVE"
if [ "$CS_INDEX_AFTER" != "$CS_INDEX_BEFORE" ]; then
    die "the SNAPSHOT the gate graded changed while the gate ran." \
        "Something wrote into the private copy of the index the gate was reading," \
        "so what it graded is not one index (CS-955)." \
        "The commit is BLOCKED: an index that moved under the gate is not graded."
fi
if [ "$CS_INDEX_LIVE" != "$CS_INDEX_BEFORE" ]; then
    die "the index MOVED while the gate ran, so it is not the index the gate graded." \
        "Something staged, unstaged or re-staged a path after the hook copied the" \
        "index for the gate, and git would commit the moved index ungraded (CS-955)." \
        "Let whatever else is staging finish, then run the commit again." \
        "The commit is BLOCKED: an index that moved under the gate is not graded."
fi

exit 0
