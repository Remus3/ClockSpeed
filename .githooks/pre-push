#!/bin/sh
# Clockspeed pre-push hook - the fast unit subset (CONVENTIONS.md section 8).
#
# Runs pytest against the tests directory, quiet, with -x so the first failure
# stops the run and the push.
#
# If pytest is not importable this hook FAILS. It does not skip. CONVENTIONS.md
# section 7.2: "The unrun gate is where the bug hides. A skipped suite is not a
# passing suite." Exit code 5 (no tests collected) is likewise a failure - an
# empty suite proves nothing.
#
# CS-821: THE VERDICT IS WHAT THE RUN EXECUTED, NOT THE EXIT CODE PYTEST CHOSE.
# The run writes a junit report into a private mktemp directory outside the
# repository and the hook reads it back. A missing report, an unreadable one, or
# one recording zero executed tests REFUSES, whatever status pytest returned. A
# skipped test is NOT RUN. See the block above the pytest run for the detail.
#
# LF line endings, no BOM - see the note in .githooks/pre-commit.

set -u

die() {
    printf 'clockspeed pre-push: %s\n' "$1" >&2
    shift
    for line in "$@"; do
        printf '  %s\n' "$line" >&2
    done
    exit 1
}

# CS-954: CAPTURE THE REF LIST BEFORE ANYTHING ELSE RUNS.
#
# Until this existed the hook never read its stdin at all - every redirect in
# this file is </dev/null - so it graded the WORKING TREE and never learned which
# commits were being pushed. A gate that can report on a commit that never ships
# and stay silent about one that does is the CS-821 and CS-824 family one level
# up, which is why this is tier 1.
#
# THE INCIDENT, 2026-09-07. The hook was handed one commit, ran the whole suite,
# and git printed that commit's range and exited 0. The forge holds a LATER
# commit, created by the same session while the hook was still running. The
# forge settles it: no CI run has ever existed for the SHA the hook graded, and
# exactly one push-event run exists for the later commit, created three seconds
# after the ref update.
#
# THE MECHANISM IS NOT ESTABLISHED, AND THIS BLOCK DOES NOT PRETEND OTHERWISE.
# Two controlled reproductions on 2026-09-08 - one over a plain local path, one
# over file:// - advanced the local ref mid-hook and BOTH shipped exactly the SHA
# the hook was handed, with a control proving the ref really had moved by the
# time the hook returned. The real incident used HTTPS to the forge and the
# difference is unexplained.
#
# SO THIS CHECK NARROWS THE WINDOW AND DOES NOT CLOSE IT. It compares the ref at
# the hook's own exit against what git handed it. A ref that moves AFTER this
# hook returns and before git resolves what to send is still unguarded, and that
# residual gap is unbounded and unmeasured. Do not write down that CS-954 is
# closed by this block.
#
# READ EXACTLY ONCE. stdin is a stream, not a file; a second read gets nothing.
# Everything downstream already carries an explicit </dev/null, so nothing can
# inherit it either.
#
# EMPTY STDIN IS LOUD AND DOES NOT REFUSE. `git push` with nothing to do, and a
# hand-run or test invocation of this hook, both arrive that way. A silent no-op
# there would be indistinguishable from a check that never ran.
#
# A TERMINAL IS NOT READ AT ALL, and this guard is a REGRESSION REPAIR rather
# than a precaution. The first version of this block read stdin unconditionally,
# and an adversary measured what that does when someone runs this file by hand:
# `cat` waits for an end-of-file the terminal never sends, so the hook HANGS
# FOREVER where it used to exit. A hung gate reads as a wedged suite and gets
# killed rather than diagnosed, which is worse than either answer.
#
# WHAT THIS DOES NOT COVER, stated rather than implied: stdin held open by
# another process - a pipe whose writer never exits - still blocks here, exactly
# as it would for any program that reads until end-of-file. Real `git push`
# always closes the pipe, so that case is reachable only by constructing it.
if [ -t 0 ]; then
    CS_REFS=""
else
    CS_REFS=$(cat)
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
if [ -z "$ROOT" ]; then
    die "not inside a git work tree; refusing to run."
fi

TESTS="$ROOT/tests"
if [ ! -d "$TESTS" ]; then
    die "no tests directory at $TESTS" \
        "Refusing to push an unverified tree." \
        "Run: python scripts/verify_env.py"
fi

CS_PY=""
CS_PY_ARG=""
# CS-815: whether cs_probe runs its stdin half. ASSIGNED here, outside the
# byte-identical probe, never read from the environment -
# this file hands no program on stdin, so the half is skipped.
CS_HOOK_STDIN_HALF=skip

# THE PROBE PROVES THE CANDIDATE BOTH RUNS A PROGRAM AND CAN REPORT ITS FAILURE.
#
# CS-703: the previous probe ran the candidate with -c and read only its exit
# status, so `true`, `:` and `echo` all passed it. The heredoc or the gate
# invocation was then handed to that program, which ignored it and exited 0, and
# the hook reported success - one environment variable silently disarmed the
# character-set gate, the secret scan, the message checks and the pre-push suite
# at once. An unrunnable check is not a passed check, and neither is a check
# handed to something that cannot run it.
#
# THE SECOND HALF EXISTS BECAUSE THE GATES READ A CHANNEL THE FIRST HALF NEVER
# VALIDATES. Every gate decision in every one of these hooks is taken from `$?`.
# A probe that compares only stdout therefore proves the candidate RAN the
# program and says nothing about whether it can REPORT a failure - so a wrapper
# that forwards stdout faithfully and drops the exit status answers the first
# half with the exact token and turns all three tier-0 gates into no-ops. Two
# ordinary shapes do exactly that, and neither is purpose-built nor knows the
# token: a POSIX wrapper ending in `| cat`, because a pipeline's status is its
# LAST command's, and a Windows .cmd shim wrapping its body in `setlocal` /
# `endlocal`, because `endlocal` resets ERRORLEVEL. The second half hands the
# candidate a program that exits 97 and demands 97 back. The sentinel avoids 0,
# 1, 2 and 5, which are ordinary results, and 125, 126 and 127, which `env` and
# the shell itself produce on an exec failure - so a candidate that never ran the
# program cannot answer correctly by accident.
#
# CS-815: BOTH QUESTIONS ARE ASKED OF ONE START. The program prints the token
# AND exits 97, and the probe demands both from that one run. Two starts
# asked nothing more than one: a candidate that forwards stdout and drops the
# status still answers 0, and one that cannot run the program still prints
# no token. Folding them halved the probe's cost on every hook call.
#
# THAT ESCAPE WAS REACHABLE THROUGH THE `python` RUNG WITH NO ENVIRONMENT
# VARIABLE SET AT ALL. It was never a CLOCKSPEED_PYTHON problem, and unsetting
# that variable was never a mitigation for it.
#
# THE TOKEN IS ASSEMBLED FROM THREE PIECES at run time, so the string being
# compared never appears literally in the program text the candidate is handed.
# A candidate that merely echoes its arguments back cannot reproduce it by
# accident, and `echo` is the live example of one that tries.
#
# THE COMPARISON IS EXACT RATHER THAN CONTAINMENT, deliberately. Exact equality
# refuses a candidate whose stdout carries anything extra - a sitecustomize that
# prints, a .cmd shim without `@echo off`, PYTHONIOENCODING=utf-8-sig - and each
# of those is a FALSE REFUSAL this accepts knowingly. Containment would accept
# all three, and would also accept any program that emits the token among other
# output. In a gate a LOUD FALSE REFUSAL beats a SILENT FALSE ACCEPT: the
# message below fixes the first in a minute, and the second is the defect that
# made this item exist.
#
# THE TOKEN CARRIES NO TRAILING NEWLINE, so the comparison never depends on how
# the interpreter and the shell each treat a line terminator. Measured here:
# python writes CR LF to a pipe and this bash strips both, so the newline form
# happens to compare equal on THIS toolchain - exactly the version-specific
# tolerance CONVENTIONS.md section 16 says to re-measure rather than inherit.
# Writing no newline removes the dependency instead of resting on it.
#
# THIS IS AN ACCIDENT DETECTOR, NOT A SECURITY BOUNDARY. It catches a
# MISCONFIGURED interpreter, which is what CS-703 was. It stops nobody who means
# to get past it: a program written on purpose to print the token and exit 97
# passes both halves, and `git commit --no-verify` skips every hook here without
# needing to. Never cite this probe as evidence that a commit was checked.
CS_PROBE_PROGRAM='import sys; sys.stdout.write("clockspeed-" + "python-" + "ok"); sys.exit(97)'
CS_PROBE_EXPECTED='clockspeed-python-ok'
CS_PROBE_EXIT_EXPECTED=97
CS_PROBE_BOUND=10
CS_PROBE_CAPTURE='cs_o=$("$@"); cs_r=$?; printf "%s" "$cs_o"; exit "$cs_r"'

cs_probe() {
    # ALL initialised BEFORE first use. The failure paths below render them,
    # and `set -u` would abort the hook on an unset one instead. The exit code
    # starts as a WORD rather than a number on purpose: a refusal that never
    # reached the second half must not be readable as "the candidate returned 0".
    cs_probe_out=""
    cs_probe_code="not reached"
    cs_probe_rc="not reached"
    cs_probe_bound_ok=""
    # CS-816: EVERY HALF OF THIS PROBE RUNS UNDER A BOUND OF CS_PROBE_BOUND
    # SECONDS, AND A HALF THAT DOES NOT RETURN INSIDE IT REFUSES THE HOOK.
    # Three hang shapes were measured, none of them exotic. PYTHONINSPECT=1
    # goes interactive after the program, because under MSYS /dev/null is the
    # NUL character device and reports a tty. A candidate that leaves a
    # background process holding stdout makes a command substitution wait for
    # that process rather than for the candidate. A wrapper that execs python
    # with stdin from /dev/null answers every -c program and then spins on a
    # program handed to it on stdin. The answer is a BOUND rather than an
    # enumeration of causes, and so the probe also hands the candidate one
    # program on stdin - the shape commit-msg delivers its checker in - and
    # grades only that it RETURNS.
    #
    # THE BOUND IS ONE LITERAL, byte-identical in the three hooks and never read
    # from the environment or a config file. Its value is justified against a
    # cold-start measurement in the closing record of CS-816 in docs/LEDGER.md.
    #
    # A TIMED-OUT PROBE NEVER FALLS THROUGH to the next rung. The last rung is
    # 'py -3', the measured interpreter that carries no toolchain, and a probe
    # that timed out and then proceeded is the CS-703 no-op wearing a clock. An
    # ordinary MISMATCH still falls through exactly as it always did.
    #
    # THE BOUNDING BINARY IS CHECKED BY BEHAVIOUR, NEVER BY NAME. On Windows,
    # System32 carries a 'timeout' that is a pause command with unrelated
    # semantics, behind GNU timeout on PATH. Before any candidate runs, the
    # binary must pass an ordinary exit status straight through AND return 124
    # when a short bound expires. Absent, foreign, or never expiring, it refuses
    # the hook: a probe is never run without a time limit.
    #
    # CS-1200: 137 IS A WORKING BOUND TOO. It is the KILL sent after the
    # one-second grace, and a loaded box measured it in 2 of 12 runs, when
    # 'sleep' outlived the TERM. Either status proves the bound fired; a binary
    # that never expires still answers 0 here and still refuses.
    timeout -k 1 "$CS_PROBE_BOUND" sh -c 'exit 42' </dev/null >/dev/null 2>&1
    if [ "$?" = 42 ]; then
        timeout -k 1 0.05 sleep 5 </dev/null >/dev/null 2>&1
        case "$?" in
            124 | 137) cs_probe_bound_ok="yes" ;;
        esac
    fi
    if [ "$cs_probe_bound_ok" != "yes" ]; then
        die "no working GNU timeout was found, so the interpreter probe cannot be bounded." \
            "The hook refuses rather than run a probe with no time limit (CS-816)." \
            "'timeout' is checked by behaviour: it must pass an ordinary exit status" \
            "through and return 124 when its bound expires, or 137 when the kill" \
            "after its grace ends the run. A different program of the same name," \
            "such as the Windows pause command, fails that check." \
            "Fix: put GNU coreutils 'timeout' and 'sleep' first on PATH. Git for" \
            "Windows ships both in its own usr/bin directory." \
            "BLOCKED: an unbounded probe is not a passed probe."
    fi
    # THE CAPTURE RUNS INSIDE THE BOUNDED PROCESS. CS_PROBE_CAPTURE is a small sh
    # program that takes the candidate's output itself and re-emits it, so the
    # only processes holding THIS substitution's pipe are ones the bound kills.
    # Capturing the candidate here directly would let a background process it
    # left behind hold the pipe after the bounded child exited, and this
    # substitution would wait on that process with no limit at all.
    #
    # THE EXIT STATUS IS GRADED BEFORE THE TOKEN. MEASURED under a 3 second
    # bound: PYTHONINSPECT=1 returned 124 while the capture already held the
    # exact token. 124 is the bound expiring, 137 the KILL sent when a candidate
    # ignored TERM, and 143 a TERM from elsewhere. Each refuses, whatever the
    # capture holds.
    #
    # ONE START ANSWERS BOTH QUESTIONS (CS-815). $? is captured IMMEDIATELY on
    # the next line, because any command in between - a `[` included -
    # overwrites it. The status is RECORDED only when the token matched, so
    # 'not reached' still means the output check failed or nothing ran.
    cs_probe_out=$(timeout -k 1 "$CS_PROBE_BOUND" sh -c "$CS_PROBE_CAPTURE" \
        cs_probe "$@" -c "$CS_PROBE_PROGRAM" 2>/dev/null </dev/null)
    cs_probe_rc=$?
    if [ "$cs_probe_out" = "$CS_PROBE_EXPECTED" ]; then
        cs_probe_code=$cs_probe_rc
        # THE STDIN HALF runs unless the CALLER declared CS_HOOK_STDIN_HALF as
        # 'skip' outside this probe. Every caller assigns it, so no inherited
        # value reaches here; unset - an extracted copy - runs it. Only
        # commit-msg hands a program on stdin, and only it declares 'run'.
        if [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ] &&
            [ "${CS_HOOK_STDIN_HALF:-run}" != skip ]; then
            # THE STDIN HALF grades only that the candidate RETURNS inside the
            # bound. Its output and its status are deliberately not compared:
            # this half exists for the hang, and a stricter grade here would
            # refuse candidates that the two halves above already judge.
            printf '%s' "$CS_PROBE_PROGRAM" | timeout -k 1 "$CS_PROBE_BOUND" \
                sh -c "$CS_PROBE_CAPTURE" cs_probe "$@" - >/dev/null 2>&1
            cs_probe_rc=$?
        fi
    fi
    case "$cs_probe_rc" in
        124|137|143)
            die "the interpreter probe did not answer within $CS_PROBE_BOUND seconds." \
                "Observed status: [$cs_probe_rc] (124 is the bound expiring)." \
                "A probe that times out REFUSES and never falls through to the next" \
                "rung: the last rung, 'py -3', is the measured interpreter that" \
                "carries no toolchain (CS-816)." \
                "Known causes: PYTHONINSPECT set in the environment; an interpreter" \
                "wrapper that redirects stdin from /dev/null; a wrapper that leaves a" \
                "background process holding stdout." \
                "Unset PYTHONINSPECT, or point CLOCKSPEED_PYTHON at a plain python." \
                "BLOCKED: an unanswered probe is not a passed probe."
            ;;
    esac
    # Compared as STRINGS. Both sides are literal digits here, and `=` cannot
    # raise on a non-numeric value the way `-eq` would.
    [ "$cs_probe_code" = "$CS_PROBE_EXIT_EXPECTED" ]
}

cs_python() {
    if [ -n "$CS_PY_ARG" ]; then
        "$CS_PY" "$CS_PY_ARG" "$@"
    else
        "$CS_PY" "$@"
    fi
}

# >>> CS-818 LADDER BEGIN - resolves CS_PY and CS_PY_ARG; pinned across the hooks.
if [ -n "${CLOCKSPEED_PYTHON:-}" ]; then
    # SET BUT FAILING IS A HARD FAILURE, NOT A FALL-THROUGH. The old form was
    # one `&&` condition, so a value that failed the probe fell quietly through
    # to `python`: the operator's explicit choice was overruled, the run
    # continued under an interpreter they did not pick, and nothing said so.
    # That is the CS-806 shape in a quieter form. Refusing costs one loud
    # message; falling through costs silence.
    if cs_probe "$CLOCKSPEED_PYTHON"; then
        CS_PY="$CLOCKSPEED_PYTHON"
    else
        # NONE OF THE CANDIDATE'S OUTPUT IS RENDERED, only its size (CS-814). A
        # candidate that ignores its arguments can print anything - its own
        # environment, and the live credentials in it, included - and this text
        # reaches logs and reports (CLAUDE.md non-negotiable 13). The VALUE of
        # CLOCKSPEED_PYTHON is not echoed back either: it is routinely an
        # absolute path under a home directory (non-negotiable 3).
        cs_probe_bytes=$(printf '%s' "$cs_probe_out" | wc -c 2>/dev/null | tr -d ' ')
        die "CLOCKSPEED_PYTHON is set but did not answer the probe." \
            "It must name ONE EXECUTABLE, not a command line with arguments." \
            "'py -3' is two tokens, so it cannot be this variable's value. Unset" \
            "the variable and the ladder reaches 'py -3' by itself, last." \
            "Observed probe output: [$cs_probe_bytes] bytes, not shown - a candidate" \
            "that ignores its arguments can print the environment (CS-814)." \
            "Observed exit status when asked to fail: [$cs_probe_code]" \
            "(expected $CS_PROBE_EXIT_EXPECTED; 'not reached' means this half" \
            "never ran. That happens BOTH when the candidate could not be" \
            "executed at all AND when it ran but answered the output check" \
            "wrongly - zero bytes above point at the first.)" \
            "An interpreter must BOTH run the program it is handed AND report a" \
            "failure back. That is CS-703: judging the exit code alone let 'true'," \
            "':' and 'echo' through, and judging stdout alone let a wrapper that" \
            "forwards output but drops the exit status turn every tier-0 gate" \
            "into a no-op." \
            "Point CLOCKSPEED_PYTHON at a working python executable, or unset it." \
            "The push is BLOCKED: an unrunnable suite is not a passing suite."
    fi
elif cs_probe python; then
    CS_PY="python"
elif cs_probe python3; then
    CS_PY="python3"
elif cs_probe py -3; then
    CS_PY="py"
    CS_PY_ARG="-3"
else
    die "no usable python interpreter found." \
        "Tried \$CLOCKSPEED_PYTHON, 'python', 'python3', 'py -3'." \
        "Set CLOCKSPEED_PYTHON to an interpreter and retry." \
        "The push is BLOCKED: an unrunnable suite is not a passing suite."
fi
# <<< CS-818 LADDER END

# CS-821: PYTEST MUST BE THE INSTALLED ONE, CHECKED THE WAY THE RUN WILL SEE IT.
#
# THE DEFECT. `import pytest` succeeding proved only that SOMETHING named pytest
# imported. A pytest.py first on PYTHONPATH, or at the repository root where
# `-m` puts the working directory on sys.path, ran instead of the real one - and
# one that wrote a plausible report and exited 0 shipped a push that ran nothing.
#
# TWO DEFENCES, AND THE CHECK RUNS UNDER EXACTLY THE RUN'S SETTINGS. `-P` is the
# interpreter's safe-path mode: the working directory is never put on sys.path,
# so a pytest.py in the pushed tree cannot shadow the real one. The check then
# requires the pytest it imports to live under one of the interpreter's own
# site-packages directories, which refuses a PYTHONPATH shadow. PYTHONPATH is
# deliberately NOT stripped from the run: an operator or a test may use it to
# hide a plugin, and the check below grades the same sys.path the run gets.
#
# An interpreter without safe-path mode (before 3.11) rejects `-P` or reports
# the flag unset, and either REFUSES - it is never retried without the flag.
#
# NOT COVERED, stated rather than implied. xdist starts its workers with its own
# command line and no `-P`, so a worker still has the working directory on
# sys.path; the controller that writes the report does not.
CS_PYTEST_WHERE='
import os
import site
import sys
import sysconfig
if not sys.flags.safe_path:
    sys.exit(5)
try:
    import pytest
except Exception:
    sys.exit(3)
where = getattr(pytest, "__file__", None)
if not isinstance(where, str):
    sys.exit(4)
roots = list(site.getsitepackages())
roots.append(site.getusersitepackages())
roots.extend(sysconfig.get_path(key) for key in ("purelib", "platlib"))
where = os.path.normcase(os.path.realpath(where))
for root in roots:
    base = os.path.normcase(os.path.realpath(root))
    try:
        if os.path.commonpath([base, where]) == base:
            sys.exit(0)
    except ValueError:
        pass
sys.exit(4)
'
cs_python -P -c "$CS_PYTEST_WHERE" >/dev/null 2>&1 </dev/null
cs_where_rc=$?
if [ "$cs_where_rc" = 3 ]; then
    die "pytest is not available to the resolved interpreter." \
        "The unit subset did NOT run, so this push is BLOCKED." \
        "A skipped suite is not a passing suite (CONVENTIONS.md 7.2)." \
        "Run: python scripts/verify_env.py"
fi
if [ "$cs_where_rc" = 4 ]; then
    die "pytest does not resolve from the interpreter's site-packages; refusing a shadow." \
        "Something named pytest - on PYTHONPATH, most likely - would run in place of" \
        "the installed one, and it need not run a single test." \
        "BLOCKED (CS-821): unset PYTHONPATH or remove the stray pytest module."
fi
if [ "$cs_where_rc" != 0 ]; then
    die "the resolved interpreter cannot run pytest in safe-path mode (-P)." \
        "Observed status: [$cs_where_rc]. Safe-path mode needs Python 3.11 or later;" \
        "without it the working directory can shadow pytest." \
        "BLOCKED (CS-821): point CLOCKSPEED_PYTHON at a newer interpreter."
fi

# CS-989: A PUSH THAT ONLY DELETES REFS IS NOT GRADED, BECAUSE THERE IS NOTHING
# TO GRADE. The CS-954 block below already states it in its own words: git sends
# the all-zero id as the local sha when a ref is being deleted, nothing was
# graded and nothing ships. The ref list arrives on stdin before the suite runs,
# so paying for a whole suite to learn what the hook was handed at the top is
# cost with no coverage attached. Authorized by the frozen-file grant recorded in
# docs/LEDGER.md under "2026-09-12 - CS-989"; read its twelve conditions before
# changing a byte of this block, and do not widen it.
#
# THE PLACEMENT IS PART OF THE GRANT. This sits BELOW the interpreter ladder and
# the pytest-importability probe on purpose. Above them there would be a class of
# push that runs zero checks at all and never learns its interpreter is broken,
# which is the CS-703 no-op shape and falsifies CS-821's acceptance.
#
# THE DEFAULT IS RUN-THE-SUITE. This is a per-line loop that sets a disqualifying
# flag the moment one line is not a deletion - never a `grep -q` and never a
# `case` over the whole blob, either of which answers ANY when the question is
# EVERY. One shipping ref in a batch of fifty deletions must still cost the full
# suite, because that ref is exactly the thing a gate exists to grade.
#
# AN EMPTY REF LIST IS EXCLUDED BEFORE THE LOOP EVER RUNS. Running this file by
# hand, a test invocation and a push with no ref to update all arrive with
# nothing on stdin, and a loop over nothing satisfies EVERY vacuously - which
# would skip the suite for all three. Those keep the existing behaviour exactly.
#
# A MALFORMED LINE DISQUALIFIES THE WHOLE PUSH rather than being skipped. The sha
# field must be a NON-EMPTY string containing no character other than zero. The
# CS-954 loop's own spelling is deliberately not reused: `*[!0]*) ;; *) continue`
# treats the EMPTY string as all-zeros, which is harmless where it only declines
# to check one line and is not harmless where it decides whether the suite runs.
#
# THE MESSAGE RENDERS THE REF COUNT AND NOTHING ELSE - never a raw stdin line,
# never the remote URL, never a path. Non-negotiables 3 and 12, the same reason
# the CS-954 block refuses to echo them.
CS_SUITE_RAN=1
cs_all_deletes=0
cs_delete_count=0
cs_line_ref=""
cs_line_sha=""
if [ -n "$CS_REFS" ]; then
    cs_all_deletes=1
    # Field order on each line is: local-ref local-sha remote-ref remote-sha.
    while read -r cs_line_ref cs_line_sha _; do
        if [ -z "$cs_line_ref" ] || [ -z "$cs_line_sha" ]; then
            cs_all_deletes=0
            break
        fi
        case "$cs_line_sha" in
            *[!0]*)
                cs_all_deletes=0
                break
                ;;
        esac
        cs_delete_count=$((cs_delete_count + 1))
    done <<CS_989_REFS
$CS_REFS
CS_989_REFS
fi

if [ "$cs_all_deletes" -eq 1 ] && [ "$cs_delete_count" -gt 0 ]; then
    # A NAMED STATE VARIABLE, not a bare `exit 0`, so a later check can ask
    # whether the suite ran rather than infer it from the exit code.
    CS_SUITE_RAN=0
    printf 'clockspeed pre-push: %s ref deletion(s) and nothing else on stdin, ' \
        "$cs_delete_count" >&2
    printf 'so the suite did NOT run - CS-989. A deletion grades nothing and ' >&2
    printf 'ships nothing. THIS PUSH SAYS NOTHING ABOUT WHETHER THE TREE IS ' >&2
    printf 'GREEN; push a commit to learn that.\n' >&2
    exit 0
fi

# Explicit target directory, run from the repo root. Never a bare recursive
# invocation from the root - that can sweep runtime state directories
# (CONVENTIONS.md section 7.1). stdin is the ref list git handed us; pytest
# must not inherit it.
#
# SERIAL OR PARALLEL IS DECIDED HERE, ONCE, BEFORE THE RUN (CS-906, under the
# frozen-file grant recorded in docs/LEDGER.md; read its thirteen conditions
# before changing anything in this block).
#
# THE SUITE IS NEVER RE-RUN. A try-parallel-then-retry-serial shape would run
# a red suite twice and could turn a flaky red green, which is the CS-703
# no-op shape one level up. One decision, one run.
#
# THE CHOICE IS AN IMPORTABILITY PROBE, NEVER A PARSE OF PYTEST OUTPUT, and it
# uses cs_python rather than python on purpose: those are DIFFERENT
# interpreters whenever CLOCKSPEED_PYTHON is set, and a probe that asks one
# interpreter about a plugin the other will load reports on nothing.
#
# A MISSING PLUGIN COSTS SPEED AND NOT COVERAGE, so its absence degrades to
# serial and does NOT block the push - refusing here would buy no safety. The
# degrade is LOUD because a silent one is indistinguishable from a lane that
# was never parallel.
#
# MEASURED 2026-09-06 on this machine, one byte-identical tree. NOTE THE
# WORKER COUNT: `-n auto` resolves to 8, not 16 - xdist counts PHYSICAL
# cores and this box is 8 physical / 16 logical.
#
# 765s serial. 318s and 387s distributed under xdist's DEFAULT scheduler.
# 233s and 243s distributed under `--dist loadfile`. Same 5371 passed and
# 4 skipped every run, so the scheduler costs no coverage.
#
# LOADFILE IS KEPT ON A PAIRED READING, NOT ON THOSE FOUR. Measured back to
# back, both matching this exact invocation: default 308s, loadfile 253s.
# The unpaired readings above were taken across a contended machine and
# overstated the gap.
#
# AND IT DOES NOT SHOW ON A REAL PUSH. Two pushes through this hook took
# 321s and 320s, the second with loadfile, and pytest reported 317.93s and
# 316.98s. Push wall clock carries more variance than the flag saves, so do
# NOT quote a push-time benefit for it. What IS measured on real pushes is
# serial against distributed: 765s to 320s, about 2.39x.
PYTEST_PARALLEL=""
if cs_python -c "import xdist" >/dev/null 2>&1; then
    PYTEST_PARALLEL="-n auto --dist loadfile"
else
    printf 'clockspeed pre-push: xdist is not importable, so the suite runs ' >&2
    printf 'SERIAL - slower, not weaker. Restore the parallel lane with: ' >&2
    printf 'python -m pip install -e ".[dev]"\n' >&2
fi

# CS-821: THE RUN IS JUDGED BY WHAT IT EXECUTED, READ FROM PYTEST'S OWN REPORT.
# Authorized by the frozen-file grant recorded in docs/LEDGER.md under "CS-821,
# CS-824, CS-704 - FROZEN-FILE GRANT"; read its conditions before changing this.
#
# THE DEFECT. The importability check above passes a one-comment pytest.py placed
# first on PYTHONPATH, `-m pytest` then runs that empty module and exits 0, and
# the push shipped with not one test run. A tree whose every test is skipped
# exits 0 the same way. An exit status says what pytest CHOSE to return; only a
# record of the tests themselves says what ran.
#
# THE REPORT GOES INTO A FRESH mktemp DIRECTORY, never a pre-made file: mktemp's
# own empty file would read as "a report exists" to a shadow that never wrote
# one. The directory must resolve OUTSIDE the repository, measured on the
# resolved paths, and a trap removes it on every exit path, `die` included.
#
# NOTHING HERE RENDERS THE REPORT'S PATH. It sits under the operator's temporary
# directory, which is under a home directory (CLAUDE.md non-negotiable 3).
#
# RESIDUAL, NAMED AND NOT DEFENDED: A HOSTILE TRACKED CONFTEST. Code in the
# pushed tree runs inside the pytest process, so a conftest that writes a forged
# report and then calls os._exit(0) passes every check here. This gate protects
# against an ACCIDENTAL no-run and against environment and working-directory
# shadowing of pytest, never against a pushed tree written to lie about itself.
CS_REPORT_DIR=$(mktemp -d 2>/dev/null </dev/null) || CS_REPORT_DIR=""
if [ -z "$CS_REPORT_DIR" ] || [ ! -d "$CS_REPORT_DIR" ]; then
    die "no private directory could be made for pytest's report." \
        "Without a report the run cannot be judged, so the push is BLOCKED (CS-821)."
fi
trap 'rm -rf "$CS_REPORT_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cs_report_real=$(cd "$CS_REPORT_DIR" 2>/dev/null && pwd -P) || cs_report_real=""
cs_root_real=$(cd "$ROOT" 2>/dev/null && pwd -P) || cs_root_real=""
if [ -z "$cs_report_real" ] || [ -z "$cs_root_real" ]; then
    die "the report directory or the repository root would not resolve." \
        "The report's place cannot be checked, so the push is BLOCKED (CS-821)."
fi
case "$cs_report_real/" in
    "$cs_root_real"/*)
        die "the report directory resolves inside the repository; refusing to write there." \
            "Point TMPDIR outside the work tree. The push is BLOCKED (CS-821)."
        ;;
esac
CS_REPORT="$CS_REPORT_DIR/report.xml"

# THE READER. It prints "<executed> <passed>" and nothing else, and exits
# non-zero on anything it cannot read as a pytest junit report. A testcase with
# a skipped child is NOT RUN - xfail is written that way too. Deselected tests
# never appear in the report at all. `-I` keeps PYTHONPATH and the user site out
# of the reader. That is hardening against a shadowed xml module, and no arm
# in tests/test_pre_push_suite_floor.py measures it.
CS_REPORT_PROGRAM='
import sys
import xml.etree.ElementTree as ET
try:
    root = ET.parse(sys.argv[1]).getroot()
except Exception:
    sys.exit(3)
if root.tag not in ("testsuites", "testsuite"):
    sys.exit(3)
executed = 0
passed = 0
for case in root.iter("testcase"):
    kinds = {child.tag for child in case}
    if "skipped" in kinds:
        continue
    executed += 1
    if not kinds & {"failure", "error"}:
        passed += 1
sys.stdout.write("%d %d" % (executed, passed))
'

# Unquoted on purpose: the empty case must expand to NO argument, and sh has
# no arrays. The variable is initialised above, so `set -u` is satisfied.
cs_python -P -m pytest "$TESTS" -q -x $PYTEST_PARALLEL --junitxml "$CS_REPORT" </dev/null
STATUS=$?

if [ "$STATUS" -eq 5 ]; then
    die "pytest collected zero tests from $TESTS." \
        "An empty suite is not a green suite; the push is BLOCKED."
fi

# CS-821: A RUN THAT CANNOT SAY WHAT IT EXECUTED IS NOT A PASSING RUN. Judged
# whatever the exit status was, so a PYTEST_ADDOPTS or plugin flag that stops
# the report being written lands here and never passes.
if [ ! -s "$CS_REPORT" ]; then
    die "pytest wrote no report of what it executed, so the run cannot be judged." \
        "pytest exit status: [$STATUS]. Known causes: a pytest that is not the real" \
        "one, such as a shadow first on PYTHONPATH; a flag in PYTEST_ADDOPTS or the" \
        "ini file that disables the junitxml plugin." \
        "BLOCKED (CS-821): an exit status alone is not evidence that a test ran."
fi
cs_counts=$(cs_python -I -c "$CS_REPORT_PROGRAM" "$CS_REPORT" 2>/dev/null </dev/null) ||
    cs_counts=""
cs_executed=${cs_counts% *}
cs_passed=${cs_counts#* }
# Both fields digits only, AND they must rebuild the reader's output exactly,
# so an answer with no separator or with a doubled one is refused too.
cs_counts_ok=1
case "$cs_executed:$cs_passed" in
    :*|*:|*[!0-9:]*) cs_counts_ok=0 ;;
esac
if [ "$cs_executed $cs_passed" != "$cs_counts" ]; then
    cs_counts_ok=0
fi
if [ "$cs_counts_ok" -ne 1 ]; then
    die "pytest's report could not be read as a record of executed tests." \
        "pytest exit status: [$STATUS]." \
        "BLOCKED (CS-821): a report that cannot be read judges nothing."
fi
if [ "$cs_executed" -eq 0 ]; then
    die "pytest executed zero tests; every collected test was skipped or deselected." \
        "A skipped test is NOT RUN, so this suite proves nothing." \
        "BLOCKED (CS-821): a skipped suite is not a passing suite."
fi
# A GREEN EXIT BESIDE A RED REPORT IS REFUSED. A conftest that rewrites
# session.exitstatus to 0 hands this hook a success over failed tests. Only the
# green case is judged here: a red exit already blocks below, with its own words.
if [ "$STATUS" -eq 0 ] && [ "$cs_passed" -ne "$cs_executed" ]; then
    die "pytest's report records failed or errored tests, yet pytest exited 0." \
        "Executed: [$cs_executed]. Passed: [$cs_passed]." \
        "BLOCKED (CS-821): the report of what ran outranks the exit status."
fi

# CS-824: A GREEN RUN MUST ALSO BE A WHOLE ONE. Under the frozen-file grant
# recorded in docs/LEDGER.md under "CS-821, CS-824, CS-704 - FROZEN-FILE GRANT"
# and its "CS-824 - GRANT CLARIFICATION". A tree cut down to a handful of passing
# tests runs, reports and exits 0, and every check above accepts it.
#
# THE FLOOR IS ONE LITERAL LINE and nothing else sets it: not the environment,
# not a config file, not the pushed tree. The assignment below overwrites any
# inherited value of the same name. Raising or lowering it needs a fresh grant,
# and its value and the pre-push count it was derived from are recorded in the
# closing entry of CS-824 in docs/LEDGER.md. Suite growth never raises it.
#
# SANDBOX COPIES in the hook tests rewrite this ONE line to a test-local value
# through tests/pre_push_floor.py, which refuses unless the line keeps exactly
# this shape: the name, an equals sign and digits, alone on the line.
CS_PASS_FLOOR=10804
if [ "$STATUS" -eq 0 ] && [ "$cs_passed" -lt "$CS_PASS_FLOOR" ]; then
    die "pytest passed $cs_passed tests, below the floor of $CS_PASS_FLOOR." \
        "A suite cut down below the floor is not the suite this gate grades." \
        "BLOCKED (CS-824): restore the tests, or seek a fresh grant to move the floor."
fi

if [ "$STATUS" -ne 0 ]; then
    printf 'clockspeed pre-push: BLOCKED (pytest exit %s). Nothing was pushed.\n' \
        "$STATUS" >&2
fi

# CS-954: THE REF MUST STILL BE WHAT THE SUITE GRADED.
#
# ONLY ON A GREEN SUITE. A red suite already blocks, and re-deciding here could
# only rewrite a non-zero status into a different one - the verdict on a red
# suite must stay the red suite's.
#
# THE DEFAULT IS REFUSAL on any mismatch or any ref that will not resolve. This
# hook already states the trade one screen up: in a gate a LOUD FALSE REFUSAL
# beats a SILENT FALSE ACCEPT. A wrong refusal here costs one message and one
# retry; a wrong acceptance is the defect that made this item exist.
#
# THE REMOTE URL AND THE RAW STDIN LINES ARE NEVER ECHOED. An HTTPS remote can
# carry an embedded credential and a local remote carries a home path -
# non-negotiables 3 and 12, the same reason this hook refuses to echo the value
# of CLOCKSPEED_PYTHON. Only the ref NAME and two object ids are rendered, and an
# object id is not personal data.
#
# A DELETE IS SKIPPED, NOT REFUSED. git sends the all-zero id as the local sha
# when a ref is being deleted; nothing was graded and nothing ships.
if [ "$STATUS" -eq 0 ] && [ -z "$CS_REFS" ]; then
    # LOUD, AND NOT A REFUSAL. A hand-run hook and a test invocation both arrive
    # with nothing on stdin, and so does a push with no ref to update. Refusing
    # would break running this file by hand; staying silent would make a check
    # that never ran look exactly like a check that ran and found nothing.
    printf 'clockspeed pre-push: no ref list on stdin, so the CS-954 ref check ' >&2
    printf 'did NOT run. The suite result above still stands.\n' >&2
fi

if [ "$STATUS" -eq 0 ] && [ -n "$CS_REFS" ]; then
    # Initialised before the loop so `set -u` cannot abort on the failure path
    # that renders them - the same reason cs_probe initialises both of its own.
    cs_ref_name=""
    cs_graded=""
    cs_now=""
    cs_moved=0
    # Field order on each line is: local-ref local-sha remote-ref remote-sha.
    while read -r cs_ref_name cs_graded _ _; do
        [ -n "$cs_ref_name" ] || continue
        case "$cs_graded" in
            *[!0]*) ;;
            *) continue ;;
        esac
        cs_now=$(git rev-parse --verify --quiet "$cs_ref_name" 2>/dev/null) || cs_now=""
        if [ "$cs_now" != "$cs_graded" ]; then
            cs_moved=1
            printf 'clockspeed pre-push: BLOCKED. %s moved while the suite ran.\n' \
                "$cs_ref_name" >&2
            printf '  graded:   %s\n' "$cs_graded" >&2
            printf '  now:      %s\n' "${cs_now:-(will not resolve)}" >&2
        fi
    done <<CS_954_REFS
$CS_REFS
CS_954_REFS
    if [ "$cs_moved" -ne 0 ]; then
        die "the ref moved out from under the verdict; nothing was pushed." \
            "The suite graded one commit and the branch now points at another," \
            "so pushing would ship a commit no gate has run against - CS-954." \
            "Do not commit while a push is in flight. Re-run the push."
    fi
fi

exit "$STATUS"
